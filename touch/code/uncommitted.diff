+if (S.stats.again2) console.log(`\n${S.stats.again2} page${S.stats.again2 === 1 ? " was" : "s were"} run again from the start: the browser went away under ${S.stats.again2 === 1 ? "it" : "them"} (launched again ${S.stats.relaunched} time${S.stats.relaunched === 1 ? "" : "s"}).`);
+console.log(`\n${tally.breaks.length} break${tally.breaks.length === 1 ? "" : "s"} of ${Object.keys(tally.rules).length} rules in ${secs} s (${Math.floor(secs / 60)} min ${secs % 60} s). ${RULES.byHandOnly.length} more rules are by hand only (qa/touch-rules.json "byHandOnly").`);
+const out = opt("--json");
+if (out) {
+  fs.mkdirSync(path.dirname(path.resolve(out)), { recursive: true });
+  fs.writeFileSync(out, JSON.stringify({
+    about: "qa/touch-sweep.mjs: every break of the rules in qa/touch-rules.json", day: DAY, phone: { width: PHONE.width, height: PHONE.height }, seconds: secs,
+    households: hh.map((h) => ({ id: h.id, what: h.label })), pages: pages.map((p) => p.key), rulesRun: ONLY ?? RULES.rules.map((r) => r.id), runAgain: S.stats.again2, browserLaunchedAgain: S.stats.relaunched,
+    counts: tally.counts(), checked: Object.fromEntries(Object.entries(tally.rules).map(([id, r]) => [id, r.checked])), byKind,
+    reach: Object.fromEntries(Object.entries(tally.rules).map(([id, r]) => [id, `${new Set([...r.cells].map((c) => c.split("|")[0])).size} x ${new Set([...r.cells].map((c) => c.split("|")[1])).size}`])),
+    worst: Object.fromEntries(Object.keys(tally.rules).map((id) => [id, tally.worst(id, 10)])),
+    breaks: tally.breaks, listed: tally.soft, notChecked: tally.unchecked, said: S.said, times: S.times.sort((a, b) => b.s - a.s || a.page.localeCompare(b.page)),
+    sources: RULES.rules.map((r) => ({ id: r.id, threshold: r.threshold, source: r.source, sourceDate: r.sourceDate, checked: r.checked })),
+  }, null, 1));
+  console.log(`every break: ${out}`);
+}
+void RULE;
+process.exit(0);
