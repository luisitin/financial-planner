--- /dev/null
+++ b/tests/touch-rules.test.mjs
@@ -0,0 +1,166 @@
+// tests/touch-rules.test.mjs -- the part of the touch-and-input sweep that needs no browser, inside `npm test`:
+// every page a household is offered, drawn with the repo's fake DOM for six invented households (first open, a family,
+// a retired widow, a young renter with debts, a freelancer, a couple near retirement), against the static rules of
+// qa/touch-rules.json that need no screen:
+//   T-NAME      every control has a name, every box a label tied to it (not only a placeholder)
+//   T-KEYBOARD  a box that asks for a number brings up number keys (inputmode)
+//   T-LINK      every link opens a real page a household is offered, and its words name that page
+//   T-ONE-WAY   one filled button per card or form; the page ends with exactly one way on
+//   T-HEAD      headings skip no level; no two pages share one name
+//   T-CANCEL    a form a tap opened (+ Add another, Edit) can be closed without saving
+// Each page is drawn as it opens, and once more for each button that opens a part of it (an add form, an edit form).
+// The rest (sizes, covering, focus, scroll, Back, typing) needs a browser: node qa/touch-sweep.mjs (--fast before a push).
+//
+// A rule that breaks today is `todo` while its count does not grow (KNOWN): a fix turns it green on its own (and the
+// run then asks for KNOWN to be lowered); one more break than KNOWN fails the suite. See qa/README.md "Touch and
+// input sweep" for how to read a break and how to add a rule.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import { ROOT, RULES, RULE, DAY, FAST, households, manifests, pageList, nameBreak, keyboardBreak, linkBreak, headingBreaks, asksFor, keyWords, sharedTitles, cancelBreak, closesPart, screenList } from "../qa/touch-lib.mjs";
+import { runStaticFast } from "../qa/touch-static.mjs";
+
+/**
+ * Breaks per rule on the day this test was written (2026-11-11, at c385e41), over the six households x every offered
+ * page, each page as it opens and with each "+ Add" or Edit form a tap opens, and each screen a page draws at an address
+ * of its own (the guide's journeys some page links to, Get started's questions: qa/touch-rules.json "screens"). A count only ever goes down: lower it here
+ * when a fix lands. `node qa/touch-static.mjs --list T-LINK` lists them.
+ *   T-KEYBOARD 16  Contacts' Email and Phone boxes (type=text: the letters keyboard; 2 x 6 households), Credit cards'
+ *                  "Promo months" and "Transfer fee percent" (type=number with no inputmode; family, renter)
+ *   T-ONE-WAY 54   Step by step and Quick answers end with no way on, for each household (docs/CONVENTIONS.md lets them lead
+ *                  the way themselves; the design log entry of 2026-11-06 does not name them: the owner decides, see
+ *                  qa/touch-rules.json T-ONE-WAY "exceptionsNote"): 12; and each of Step by step's seven journeys
+ *                  (#/overview/guide/budget ...) the same way: 42 (breaker, 2026-11-11: the journeys were never drawn)
+ *   T-LINK 195     links whose words share no word with the title or the big heading of the page they open: 85; links
+ *                  whose words are only small words ("Open the page", "Go there ›", "Open ›"): 48 (they were let
+ *                  through as T-NAME's business, which only asks for a letter: breaker, 2026-11-11); on the seven
+ *                  journeys, "Do something else" (it opens Get started) and the journeys' own links: 62
+ *   T-HEAD 16      Emergency fund is the name of two pages (balance/liquidity, goals/emergency-fund); an h3 under an h1 on FIRE
+ *   T-CANCEL 4     Budget's "+ Add an envelope by hand" opens a form with no Cancel while there are no envelopes yet
+ */
+const KNOWN = { "T-NAME": 0, "T-KEYBOARD": 16, "T-ONE-WAY": 54, "T-LINK": 195, "T-HEAD": 16, "T-CANCEL": 4 };
+const HERE = ["T-NAME", "T-KEYBOARD", "T-ONE-WAY", "T-LINK", "T-HEAD", "T-CANCEL"];
+
+const run = await runStaticFast();
+const counts = run.tally.counts();
+
+test("qa/touch-rules.json: every rule has a concern, a check in exact terms, a line, a source and the day it was read", () => {
+  const ids = new Set();
+  for (const r of RULES.rules) {
+    assert.ok(/^[TD]-[A-Z-]+$/.test(r.id) && !ids.has(r.id), `${r.id}: an id, once`); ids.add(r.id);
+    assert.ok(Object.keys(RULES.concerns).includes(r.concern), `${r.id}: concern "${r.concern}" is not one of ${Object.keys(RULES.concerns).join(", ")}`);
+    assert.ok(["browser", "node", "both"].includes(r.where), `${r.id}: where (a rule no machine can hold a page to goes in byHandOnly)`);
+    for (const k of ["check", "threshold", "source", "sourceDate", "checked"]) assert.ok(typeof r[k] === "string" && r[k].length > 3, `${r.id} needs ${k}`);
+    assert.ok(/^\d{4}-\d{2}-\d{2}$/.test(r.checked), `${r.id}: checked is a day`);
+    // a figure with no published source says so (the owner's rule for figures)
+    if (!/https?:\/\//.test(r.source)) assert.ok(/OURS|ours|docs\/|AGENTS\.md/.test(r.source), `${r.id}: a source with no address must be marked ours or name a file of this repo`);
+  }
+  for (const h of RULES.byHandOnly) {
+    for (const k of ["id", "concern", "what", "why", "how"]) assert.ok(h[k], `by hand only ${h.id ?? "?"} needs ${k}`);
+    assert.equal(h.where, "by hand", `${h.id}: where`);
+    assert.ok(Object.keys(RULES.concerns).includes(h.concern), `${h.id}: concern`);
+  }
+  assert.ok(/^\d{4}-\d{2}-\d{2}$/.test(DAY) && RULES.phone.width === 390 && RULES.phone.height === 844);
+});
+
+test("every rule is checked somewhere: the browser sweep names it, and the plain-Node rules are the ones counted here", () => {
+  const sweep = fs.readFileSync(path.join(ROOT, "qa", "touch-sweep.mjs"), "utf8");
+  for (const r of RULES.rules) {
+    if (r.where !== "node") assert.ok(sweep.includes(`"${r.id}"`), `${r.id} is not checked by qa/touch-sweep.mjs`);
+    assert.equal(r.where === "both" || r.where === "node", HERE.includes(r.id), `${r.id}: where is "${r.where}", so it ${HERE.includes(r.id) ? "should not" : "should"} be counted in this test`);
+  }
+  for (const id of HERE) assert.ok(RULE[id], `${id} is not in qa/touch-rules.json`);
+  // the design log's exceptions are the rule's, and they are real pages
+  for (const k of RULE["T-ONE-WAY"].exceptions) assert.ok(/^overview\/(dashboard|start|setup|plan)$/.test(k), `T-ONE-WAY exception ${k} is not one the design log names`);
+  // every concern the owner named has rules
+  for (const k of Object.keys(RULES.concerns)) assert.ok(RULES.rules.some((r) => r.concern === k), `no rule serves "${k}"`);
+});
+
+test("the fast spread and the households name real pages and real households", async () => {
+  const pages = pageList(await manifests()).map((p) => p.key), ids = (await households()).map((h) => h.id);
+  assert.equal(ids.length, 6);
+  for (const k of FAST.pages) assert.ok(pages.includes(k), `--fast names ${k}, which is not a page a household is offered`);
+  for (const h of FAST.households) assert.ok(ids.includes(h), `--fast names household ${h}`);
+  assert.ok(pages.length > 140, "the sweep visits every offered page");
+});
+
+test("the judges: what counts as a name, a number box, a link that says where it goes, a skipped heading", () => {
+  const box = (o) => ({ kind: "box", tag: "input", type: "text", name: "", from: "", label: "", fieldLabel: "", placeholder: "", title: "", inputmode: "", moneyBox: false, disabled: false, ...o });
+  // names
+  assert.equal(nameBreak(box({ name: "Amount", from: "label" })), null);
+  assert.equal(nameBreak(box({ name: "Find a page", from: "aria-label" })), null);
+  assert.equal(nameBreak(box({ name: "e.g. 4,500", from: "placeholder", placeholder: "e.g. 4,500" })).kind, "placeholder is the only label");
+  assert.equal(nameBreak(box({ fieldLabel: "Amount" })).kind, "label not tied to the box");
+  assert.equal(nameBreak(box({})).kind, "box with no label");
+  assert.equal(nameBreak({ kind: "button", tag: "button", name: "✕", from: "text", cls: "" }).kind, "named only by a symbol");
+  assert.equal(nameBreak({ kind: "button", tag: "button", name: "Close menu", from: "aria-label", cls: "" }), null);
+  assert.equal(nameBreak({ kind: "link", tag: "a", name: "", from: "", cls: "" }).kind, "no name");
+  // keyboards
+  assert.equal(asksFor(box({ moneyBox: true, inputmode: "decimal", name: "Amount" })), "money");
+  assert.equal(keyboardBreak(box({ moneyBox: true, inputmode: "decimal", name: "Amount" })), null);
+  assert.equal(keyboardBreak(box({ type: "number", name: "Promo months" })).kind, "number box with no inputmode");
+  assert.equal(keyboardBreak(box({ type: "number", inputmode: "decimal", name: "Yearly raise" })), null);
+  assert.equal(keyboardBreak(box({ name: "Year you bought it" })).kind, "letters keyboard for a number");
+  assert.equal(keyboardBreak(box({ name: "Pension", placeholder: "e.g. County retirement plan" })), null, "a name box is not a number box");
+  assert.equal(keyboardBreak(box({ name: "What is it", placeholder: "e.g. Ana's salary" })), null);
+  assert.equal(keyboardBreak(box({ name: "Rent", placeholder: "e.g. 1,450" })).kind, "letters keyboard for a number", "an example that is a figure says the box asks for one");
+  assert.equal(keyboardBreak(box({ name: "Email" })).kind, "email box without the email keyboard");
+  assert.equal(keyboardBreak(box({ moneyBox: true, inputmode: "text", name: "Left over" })).soft, true, "a money box that may go below zero keeps the letters keyboard: listed, not counted");
+  assert.equal(keyboardBreak(box({ type: "date", name: "Starts" })), null);
+  // links
+  const mods = new Map([["cashflow/income", { title: "Income", status: "usable", aliases: ["salary", "paycheck"], purpose: "Every source of money coming in." }], ["system/docs", { title: "Docs", status: "usable", builderOnly: true }], ["system/devices", { title: "Devices", status: "planned", placeholder: true }], ["ai/assistant", { title: "Ask the plan", status: "usable", requires: "ai" }]]);
+  const link = (href, seen) => ({ kind: "link", tag: "a", href, seen, text: seen, aria: "", title: "", disabled: false });
+  assert.equal(linkBreak(link("#/cashflow/income", "Add your income ›"), mods, "overview/dashboard"), null);
+  assert.equal(linkBreak(link("#/cashflow/income", "Open ›"), mods, "overview/dashboard").kind, "words do not name the page", "nothing but small words names no page (T-NAME only asks for a letter)");
+  assert.equal(linkBreak(link("#/cashflow/income", "Your paycheck ›"), mods, "overview/dashboard").soft, true, "the page's search words: another name, listed not counted");
+  assert.equal(linkBreak(link("#/cashflow/income", "Debts ›"), mods, "overview/dashboard").kind, "words do not name the page");
+  assert.equal(linkBreak(link("#/cashflow/income", "Debts ›"), mods, "overview/dashboard", { heading: "What comes in, after debts?" }), null, "the big heading of the page it opens counts as its name");
+  assert.equal(linkBreak(link("#/cashflow/income?guide=plan&step=pay", "Step 2 ›"), mods, "overview/dashboard"), null, "a page drawn another way is judged where it lands, in the browser");
+  assert.equal(linkBreak(link("#/cashflow/nope", "Income"), mods, "overview/dashboard").kind, "no such page");
+  assert.equal(linkBreak(link("#/system/docs", "Docs"), mods, "overview/dashboard").kind, "page not switched on for a household");
+  assert.equal(linkBreak(link("#/ai/assistant", "Ask the plan"), mods, "overview/dashboard").kind, "page not switched on for a household");
+  assert.equal(linkBreak(link("#/system/devices", "Devices"), mods, "overview/dashboard").kind, "page not built yet");
+  assert.equal(linkBreak(link("#", "More"), mods, "overview/dashboard").kind, "link to nowhere");
+  assert.equal(linkBreak(link("https://www.irs.gov/", "IRS"), mods, "overview/dashboard"), null);
+  assert.deepEqual(keyWords("Pay off debts faster ›"), ["pay", "off", "debt", "faster"]);
+  // headings
+  assert.deepEqual(headingBreaks([{ level: 1, text: "A" }, { level: 2, text: "B" }, { level: 3, text: "C" }, { level: 2, text: "D" }]), []);
+  assert.equal(headingBreaks([{ level: 2, text: "A" }, { level: 4, text: "B" }])[0].kind, "heading level skipped");
+  assert.equal(headingBreaks([{ level: 3, text: "A" }])[0].kind, "heading level skipped", "a page starts at h1 or h2");
+  assert.equal(headingBreaks([{ level: 2, text: "" }])[0].kind, "empty heading");
+  // a form a tap opened: a way to close it
+  const bx = { kind: "box", tag: "input" }, save = { kind: "button", tag: "button", submit: true, seen: "Save", name: "Save" };
+  assert.equal(cancelBreak([bx, save, { kind: "button", seen: "Cancel", name: "Cancel" }], "+ Add"), null);
+  assert.equal(cancelBreak([bx, save, { kind: "button", seen: "✕", name: "Close", aria: "Close" }], "+ Add"), null, "a symbol named Close");
+  assert.equal(cancelBreak([bx, save], "+ Add").kind, "an opened form with no way to close it");
+  assert.equal(cancelBreak([{ kind: "link", seen: "Read more", name: "Read more" }], "Show more"), null, "a part with nothing to type in is not a form");
+  assert.equal(closesPart({ kind: "button", seen: "Cancelled payments", name: "Cancelled payments" }), false, "a word, not the start of one");
+  assert.deepEqual(sharedTitles(new Map([["a/b", { title: "Same", status: "usable" }], ["c/d", { title: "Same", status: "usable" }], ["e/f", { title: "Same", status: "planned" }]])), [{ title: "Same", pages: ["a/b", "c/d"] }]);
+});
+
+test("the screens a page draws at addresses of its own are listed where they live (qa/touch-rules.json screens)", async () => {
+  const mods = await manifests();
+  const sc = await screenList(mods);
+  assert.ok(sc.length >= 10 && sc.every((x) => mods.has(x.key) && x.page === `${x.key}/${x.rest.join("/")}`), `screens: ${sc.map((x) => x.page).join(", ")}`);
+  assert.ok(sc.some((x) => x.page === "overview/setup/spend"), "Get started's spending question is swept");
+});
+
+test("the fake DOM draws every offered page for every household (a page it cannot draw is skipped, never counted)", () => {
+  assert.equal(run.households.length, 6);
+  assert.ok(run.pages > 140);
+  assert.deepEqual(run.failed.map((f) => `${f.household} ${f.page}: ${f.why}`), [], "pages the fake DOM could not draw: fix the page or teach qa/touch-static.mjs the call it needs");
+  for (const id of HERE) assert.ok((run.tally.rules[id]?.checked ?? 0) > (id === "T-CANCEL" ? 30 : 100), `${id} looked at ${run.tally.rules[id]?.checked ?? 0} things: the sweep is not reaching the pages`);
+});
+
+for (const id of HERE) {
+  const n = counts[id] ?? 0, known = KNOWN[id] ?? 0, r = RULE[id];
+  const worst = run.tally.worst(id, 3).map(([p, k]) => `${p} ${k}`).join(", ");
+  const first = run.tally.breaks.find((b) => b.rule === id);
+  const todo = n > 0 && n <= known ? `${n} break${n === 1 ? "" : "s"} (known ${known}); worst: ${worst}; node qa/touch-static.mjs --list ${id}` : false;
+  if (n < known) console.log(`touch rules: ${id} is down to ${n} (KNOWN says ${known}). Lower KNOWN["${id}"] to ${n} in tests/touch-rules.test.mjs so it cannot creep back.`);
+  test(`${id} (${r.concern}): ${r.check.slice(0, 110)}`, { todo }, () => {
+    assert.ok(n <= known, `${id}: ${n} breaks, ${n - known} more than the ${known} known. Worst pages: ${worst}. First: ${first ? `${first.household} ${first.page}: ${first.kind}: ${first.control} -- ${first.measured}` : "-"}. List them: node qa/touch-static.mjs --list ${id}`);
+    assert.equal(n, 0, `${n} break${n === 1 ? "" : "s"} of ${id}. First: ${first ? `${first.household} ${first.page}: ${first.kind}: ${first.control} -- ${first.measured}` : "-"}`);
+  });
+}
