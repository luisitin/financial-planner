--- /dev/null
+++ b/qa/touch-lib.mjs
@@ -0,0 +1,351 @@
+// qa/touch-lib.mjs -- what the two halves of the touch-and-input sweep share (qa/README.md "Touch and input sweep"):
+//   qa/touch-sweep.mjs            the browser half: taps every control and types into every box on a 390 px phone
+//   tests/touch-rules.test.mjs    the plain-Node half inside `npm test`: the same static rules on every page's view,
+//                                 drawn with the repo's fake DOM (no browser, no layout)
+// Here: the rules (qa/touch-rules.json), the six invented households, the list of pages a household is offered, one
+// description of a control that reads the same in a browser and in the fake DOM (`domLib`), the judges that turn a
+// description into a rule break, and the tally both halves print. Nothing in this file needs a browser.
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+export const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+export const RULES = JSON.parse(fs.readFileSync(path.join(ROOT, "qa", "touch-rules.json"), "utf8"));
+export const RULE = Object.fromEntries(RULES.rules.map((r) => [r.id, r]));
+/** The sweep's day: every household's balances are dated this day and the browser's clock starts on it, so counts do not drift with the calendar. */
+export const DAY = RULES.day;
+const imp = (rel) => import(pathToFileURL(path.join(ROOT, rel)).href);
+
+// ---------------------------------------------------------------- households
+/**
+ * The six invented households (qa/fixtures), each a function that makes a fresh plan: first (nothing typed yet: the
+ * first open), family, widow (retired, renting), renter (young, cards and a car loan), freelancer, near (a couple a few
+ * years from retirement, as Get started leaves them). `plan()` is null for the first open: the app starts its own.
+ */
+export async function households(today = DAY) {
+  const { familyPlan } = await imp("qa/fixtures/family-plan.mjs");
+  const { widowPlan } = await imp("qa/fixtures/widow-plan.mjs");
+  const { renterDebtPlan } = await imp("qa/fixtures/renter-debt-plan.mjs");
+  const { freelancerPlan } = await imp("qa/fixtures/round8-households.mjs");
+  const P = await imp("qa/fixtures/setup-personas.mjs");
+  return [
+    { id: "first", label: "first open, nothing typed", plan: () => null },
+    { id: "family", label: "a family: two salaries, a child, a mortgage", plan: () => familyPlan(today) },
+    { id: "widow", label: "a retired widow who rents", plan: () => widowPlan() },
+    { id: "renter", label: "a young renter with cards and a car loan", plan: () => renterDebtPlan() },
+    { id: "freelancer", label: "a freelancer", plan: () => freelancerPlan() },
+    { id: "near", label: "a couple a few years from retirement", plan: () => P.finishSetup("patLee", P.patLee(today), today) },
+  ];
+}
+/**
+ * `--fast`: a fixed spread of pages (every kind of screen: lists, forms, folds, reports, the path) and two households,
+ * chosen to finish in under three minutes with 3 browsers. Will the money last? and the Federal estimate are left to the
+ * full sweep: each takes as long as five other pages (their answer is worked out again on every fresh start); the
+ * withdrawal plan and the withholding check stand for them (a report with folds, a tax form).
+ */
+export const FAST = {
+  households: ["first", "family"],
+  pages: ["overview/dashboard", "overview/start", "overview/setup", "overview/plan", "balance/net-worth", "balance/update", "cashflow/income", "cashflow/expenses", "debt/payoff", "goals/goals",
+    "goals/emergency-fund", "household/people", "insurance/policies", "investments/holdings", "property/home", "retirement/social-security", "retirement/withdrawal-strategy", "taxes/withholding", "transactions/import", "system/settings"],
+};
+
+// ---------------------------------------------------------------- pages
+/** Every module's manifest, by "group/id" (the registry's own loaders, as the shell loads them). */
+export async function manifests() {
+  const { default: registry } = await imp("modules/registry.js");
+  const out = new Map();
+  for (const r of registry) { const m = (await r.load()).default; out.set(`${r.group}/${r.id}`, m); }
+  return out;
+}
+/** A page a household is offered with no PC and no AI helper answering (core/view.js `offered`): what the phone shows. */
+export const offeredToHousehold = (m) => !!m && m.status !== "planned" && !m.placeholder && !m.builderOnly && !m.requires && m.enabledByDefault !== false;
+/** [{ key, title, aliases, purpose }] of the pages the sweep visits, in registry order. */
+export function pageList(mods) {
+  return [...mods.entries()].filter(([, m]) => offeredToHousehold(m)).map(([key, m]) => ({ key, title: m.title, aliases: m.aliases ?? [], purpose: m.purpose ?? "" }));
+}
+/**
+ * The screens of the pages listed under `screens` in qa/touch-rules.json, as pages of their own:
+ * -> [{ key: "overview/setup", rest: ["spend"], page: "overview/setup/spend", title, ... }]. A page that is not offered is left out.
+ */
+export async function screenList(mods) {
+  const out = [];
+  for (const [key, how] of Object.entries(RULES.screens ?? {})) {
+    if (key === "about" || !mods.has(key) || !offeredToHousehold(mods.get(key))) continue;
+    const list = (await import(pathToFileURL(path.join(ROOT, how.from)).href))[how.export] ?? [];
+    const m = mods.get(key);
+    for (const s of list) { const id = typeof s === "string" ? s : s.id; if (id && !(how.skip ?? []).includes(id)) out.push({ key, rest: [id], page: `${key}/${id}`, title: m.title, aliases: m.aliases ?? [], purpose: m.purpose ?? "" }); }
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------- one description of a control, for a browser and the fake DOM
+/**
+ * domLib() -> { describe(el, env), isControl(el), textOf(el), seenText(el) }. Self-contained on purpose: the browser
+ * half sends this function's source into the page, the Node half calls it on the fake DOM, so a name, a label and a
+ * keyboard are read by the same code in both. It uses only getAttribute, tagName, parentNode, childNodes and data.
+ * `env`: { byId(id) -> element | null, labelFor(id) -> label element | null }.
+ */
+export function domLib() {
+  const squeeze = (s) => String(s ?? "").replace(/\s+/g, " ").trim();
+  const isEl = (n) => !!n && typeof n.tagName === "string";
+  const tagOf = (el) => String(el.tagName).toUpperCase();
+  const attr = (el, k) => (typeof el.getAttribute === "function" ? el.getAttribute(k) : null);
+  const classes = (el) => String(attr(el, "class") ?? "").split(/\s+/).filter(Boolean);
+  const hasClass = (el, c) => classes(el).includes(c);
+  const kids = (el) => Array.from(el.childNodes ?? []);
+  const HIDDEN_FROM_EYES = ["vh", "su-vh", "sr-only", "visually-hidden"];
+  const screenOnly = (el) => HIDDEN_FROM_EYES.some((c) => hasClass(el, c));
+  /** The words under a node. `skip(el)` leaves a subtree out; block elements are set apart by a space, inline ones are not. */
+  const words = (n, skip) => {
+    if (!isEl(n)) return String(n.data ?? n.textContent ?? "");
+    if (skip && skip(n)) return "";
+    const t = tagOf(n);
+    if (t === "SCRIPT" || t === "STYLE" || t === "TEMPLATE") return "";
+    return ` ${kids(n).map((c) => words(c, skip)).join("")} `;   // every element is set apart by a space ("4" + "Enter" is not "4Enter")
+  };
+  /** What a screen reader would read (aria-hidden left out, screen-reader-only text kept). */
+  const hiddenEl = (n) => n.hidden === true || (attr(n, "hidden") !== null && attr(n, "hidden") !== undefined);
+  const textOf = (el, skip) => squeeze(words(el, (n) => attr(n, "aria-hidden") === "true" || hiddenEl(n) || (skip ? skip(n) : false)));
+  /** What an eye reads (screen-reader-only text left out). */
+  const seenText = (el, skip) => squeeze(words(el, (n) => screenOnly(n) || hiddenEl(n) || (skip ? skip(n) : false)));
+  const typeOf = (el) => (tagOf(el) === "INPUT" ? String(attr(el, "type") || "text").toLowerCase() : String(attr(el, "type") || "").toLowerCase());
+  const isBoxTag = (el) => { const t = tagOf(el); return t === "SELECT" || t === "TEXTAREA" || (t === "INPUT" && !/^(button|submit|reset|image|hidden)$/.test(typeOf(el))); };
+  const ROLES = /^(button|link|tab|checkbox|radio|switch|menuitem|option)$/;
+  /** Something a finger is meant to touch: a link with an address, a button, a box, a fold's title, or anything given a role or a tab stop. */
+  const isControl = (el) => {
+    if (!isEl(el)) return false;
+    const t = tagOf(el);
+    if (t === "A") return attr(el, "href") !== null && attr(el, "href") !== undefined;
+    if (t === "BUTTON" || t === "SELECT" || t === "TEXTAREA" || t === "SUMMARY") return true;
+    if (t === "INPUT") return typeOf(el) !== "hidden";
+    if (ROLES.test(String(attr(el, "role") ?? ""))) return true;
+    const ti = attr(el, "tabindex");
+    if (ti !== null && ti !== undefined && ti !== "" && Number(ti) >= 0) return true;
+    return attr(el, "contenteditable") === "true" || (attr(el, "onclick") !== null && attr(el, "onclick") !== undefined);
+  };
+  const up = (el, test) => { for (let p = el.parentNode; p && isEl(p); p = p.parentNode) if (test(p)) return p; return null; };
+  /** The facts about one control that do not need a screen. */
+  const describe = (el, env = {}) => {
+    const tag = tagOf(el).toLowerCase(), type = typeOf(el), role = String(attr(el, "role") ?? "");
+    const box = isBoxTag(el);
+    const aria = squeeze(attr(el, "aria-label"));
+    const by = squeeze(String(attr(el, "aria-labelledby") ?? "").split(/\s+/).filter(Boolean).map((id) => { const t = env.byId ? env.byId(id) : null; return t ? textOf(t) : ""; }).join(" "));
+    const title = squeeze(attr(el, "title")), placeholder = squeeze(attr(el, "placeholder"));
+    let label = "", tied = "", fieldLabel = "", help = "";
+    if (box) {
+      let lab = up(el, (p) => tagOf(p) === "LABEL");
