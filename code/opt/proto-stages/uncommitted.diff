+++ b/core/ui/deeper.js
@@ -0,0 +1,183 @@
+// core/ui/deeper.js -- DOM only. One helper for "the short page first, the deeper page behind it" (docs/DESIGN_LOG.md
+// 2026-11-12). A page hands over its optional parts; the helper decides, from the address and from how far the household
+// has come (core/depth.js), what is drawn:
+//
+//   the short page   the page's own first view, then  kept()  the parts this device keeps at hand (often none), then
+//                    door()  one quiet row "More about <subject> ›" until the plan is finished, the "Go deeper" card after
+//   the deeper page  #/<group>/<id>?deeper=1 (or ?deeper=<part>): a way back, the answer in one line, every part as a
+//                    headed section with "Keep this on the <page> page", then the related pages
+//
+// The level is in the address, so a redraw after a save, Back, Forward and a reload all keep it with no storage. Nothing
+// here writes the plan. Built from classes that exist (card, hero, page-list, row-link, toggle-row, pill, notice, muted,
+// small); the few extra lines of style are scoped under .dp-root. Uses only ui.h and ui.notice, so a text-only stand-in
+// of the kit (module tests) can run it.
+//
+// A part is one of
+//   { key, title, ask, build, status?, when?, heavy?, shows?, keep? }   a part of this page
+//        key     kebab-case, stable: it is in addresses and in the device's memory
+//        title   the section's heading on the deeper page ("From income to tax")
+//        ask     the row's words on the short page, as the question it answers ("How is this worked out?")
+//        build   () => Node | Node[]: called only when the part is drawn (the deeper page, or kept on the short page)
+//        status  () => string | { text, yours, alert }: one grey line under the row. `yours`: how many figures of the
+//                person's own it holds ("2 yours"); `alert`: words for something that needs a look (amber pill)
+//        when    () => boolean: offered only when it has something to show
+//        heavy   true: built when it comes near the screen (or is the part asked for, or the page is printed)
+//        shows   keys of ?show=<key> landings that live in this part
+//        keep    false: this part cannot be kept on the short page (a long table)
+//   { to: "group/id", ask, when? }                                     another page that goes deeper
+import { depth, stageOf, partAsked } from "../depth.js";
+
+/** The stage-two card's heading. One word to change if the owner prefers "More on this" (design log 2026-11-06). */
+export const HEADING = "Go deeper";
+/** Rows the "Go deeper" card shows before "All N ›". */
+export const ROWS = 4;
+
+const STYLE = `
+.dp-root .dp-back { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; margin: -6px 0 2px; }
+.dp-root .dp-part { scroll-margin-top: 0; }
+.dp-root .dp-part:focus { outline: none; }
+.dp-root .dp-part > h2 { margin-bottom: 10px; }
+.dp-root .dp-keep { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 6px; color: var(--text-2); font-size: var(--fs-sm); }
+.dp-root .dp-said { margin: 6px 0 0; }
+.dp-root .page-list .row-link { align-items: center; }
+.dp-root .page-list .t { display: block; }
+.dp-root .page-list .d { display: block; }
+.dp-root.dp-door { margin: 14px 0 0; }
+.dp-root.dp-door .page-list li { border-bottom: 0; }
+.dp-root .dp-ring { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: var(--radius-sm); }
+`;
+
+/** Addresses already landed on: a landing scrolls once per arrival, never again on the redraw after a save. */
+const landed = new WeakSet();
+
+const hrefOf = (page, query) => {
+  const qs = Object.entries(query).filter(([, v]) => v !== null && v !== undefined).map(([k, v]) => (v === "" ? encodeURIComponent(k) : `${encodeURIComponent(k)}=${encodeURIComponent(String(v))}`)).join("&");
+  return `#/${page}${qs ? `?${qs}` : ""}`;
+};
+const lower = (s) => (s ? s.charAt(0).toLowerCase() + s.slice(1) : s);
+const statusOf = (p) => { let s = null; try { s = p.status ? p.status() : null; } catch { s = null; } return typeof s === "string" ? { text: s, yours: 0, alert: null } : { text: s?.text ?? "", yours: Number(s?.yours) || 0, alert: s?.alert || null }; };
+
+export function deeper(ctx, page, parts, { title = ctx.module?.title ?? "this page", subject = lower(title), answer = null } = {}) {
+  const { ui } = ctx;
+  const query = ctx.route?.query ?? {};
+  const at = partAsked(query);
+  const stage = stageOf(ctx.plan);
+  const applies = (p) => { try { return !p.when || !!p.when(); } catch { return false; } };
+  const offeredPage = (key) => { const m = ctx.modules?.get?.(key); if (!ctx.modules) return true; return !!m && (ctx.isReady?.(m) ?? true) && (ctx.features?.enabled?.(m) ?? true) && (ctx.shown?.(m) ?? true); };
+  const own = parts.filter((p) => p.key && applies(p));
+  const pages = parts.filter((p) => p.to && applies(p) && offeredPage(p.to));
+  // the frame's keys (guide, step, from...) ride along, so the step bar and the way on stay the same on both levels
+  const { deeper: _d, show: _s, ...carry } = query;
+  const shortHref = hrefOf(page, carry);
+  const deepHref = (key = "1", extra = {}) => hrefOf(page, { ...carry, deeper: key, ...extra });
+  const style = () => ui.h("style", {}, STYLE);
+
+  // a landing (?show=<key>) whose box lives in a part: go to the deeper page at that part, in place of this entry
+  const landing = at === null && query.show ? own.find((p) => (p.shows ?? []).includes(query.show)) : null;
+  if (landing) { try { globalThis.location?.replace?.(deepHref(landing.key, { show: query.show })); } catch { } }
+
+  const draw = (p) => { try { return [p.build()].flat(Infinity).filter((n) => n !== null && n !== undefined && n !== false); } catch (e) { console.error(`[planner] part ${page}#${p.key} failed`, e); return [ui.notice("error", "This part could not be shown. Reload the page; if it stays, tell whoever set up the app.")]; } };
+  const pill = (s) => s.alert ? ui.h("span", { class: "pill warn" }, "needs a look") : s.yours ? ui.h("span", { class: "pill accent" }, s.yours === 1 ? "1 yours" : `${s.yours} yours`) : null;
+  const rowFor = (label, href, s = null, attrs = {}) => ui.h("li", {}, ui.h("a", { class: "row-link", href, ...attrs },
+    ui.h("span", { class: "body" }, ui.h("span", { class: "t" }, `${label} ›`), s?.alert || s?.text ? ui.h("span", { class: "d" }, s.alert || s.text) : null),
+    s && pill(s) ? ui.h("span", { class: "st" }, pill(s)) : null));
+
+  /** The short page's way to more: one quiet row before the plan is finished, the card of questions after. */
+  function door() {
+    const kept = depth.kept(page);
+    const left = own.filter((p) => !kept.includes(p.key));
+    const n = left.length + pages.length;
+    if (!n) return null;
+    const all = left.map(statusOf);
+    const yours = all.reduce((t, s) => t + s.yours, 0), alerts = all.filter((s) => s.alert).length;
+    if (stage === "first") {
+      const first = left[0]?.title ?? pages[0]?.ask;
+      const text = [n > 1 ? `${first} and ${n - 1} more` : first, yours ? `${yours} yours` : null].filter(Boolean).join(" · ");
+      return ui.h("nav", { class: "dp-root dp-door", "aria-label": `More about ${subject}` }, style(),
+        ui.h("ul", { class: "page-list" }, rowFor(`More about ${subject}`, deepHref("1"), { text, yours: 0, alert: alerts ? `${alerts === 1 ? "One thing" : `${alerts} things`} in here ${alerts === 1 ? "needs" : "need"} a look` : null })));
+    }
+    // a part that needs a look or holds the person's own figure is never cut off by "All N"
+    const items = [...left.map((p, i) => ({ p, s: all[i] })), ...pages.map((p) => ({ p, s: null }))];
+    let shown = items;
+    if (items.length > ROWS + 1) {
+      const must = items.filter((x) => x.s && (x.s.alert || x.s.yours));
+      const rest = items.filter((x) => !must.includes(x));
+      const pick = new Set([...must, ...rest.slice(0, Math.max(0, ROWS - must.length))]);
+      shown = items.filter((x) => pick.has(x));
+    }
+    const rows = shown.map(({ p, s }) => (p.key ? rowFor(p.ask ?? p.title, deepHref(p.key), s) : rowFor(p.ask, `#/${p.to}`)));
+    if (shown.length < n) rows.push(rowFor(`All ${n}`, deepHref("1")));
+    return ui.h("section", { class: "card dp-root dp-go", "aria-label": HEADING }, style(), ui.h("h2", {}, HEADING), ui.h("ul", { class: "page-list" }, rows));
+  }
+
+  /** The tick under a part: keep it on the short page of this device, or put it back. Acts at once and says so. */
+  function keepRow(p, host, onShort) {
+    if (p.keep === false) return null;
+    const said = ui.h("div", { class: "dp-said", role: "status" });
+    const box = ui.h("input", { type: "checkbox", checked: depth.isKept(page, p.key) ? true : null, onChange: () => {
+      const on = !!box.checked;
+      depth.keep(page, p.key, on);
+      const words = on ? `Kept. "${p.title}" now shows on the ${title} page on this device.` : `Put back. "${p.title}" is under ${stage === "first" ? `More about ${subject}` : HEADING} again.`;
+      ctx.announce?.(words);
+      if (onShort && !on) { host.replaceWith(ui.notice("ok", words)); refreshDoor(); }
+      else said.replaceChildren(ui.notice("ok", words));
+    } });
+    return ui.h("div", {}, ui.h("label", { class: "toggle-row dp-keep" }, box, ui.h("span", { class: "toggle-text" }, `Keep this on the ${title} page`)), said);
+  }
+  function section(p, onShort = false) {
+    const el = ui.h("section", { class: "card dp-part", id: `dp-${p.key}`, tabindex: "-1", dataset: { part: p.key } }, ui.h("h2", {}, p.title));
+    const body = ui.h("div", {});
+    el.append(body, keepRow(p, el, onShort));
+    // only `append` and `remove` are used while drawing, so a text-only stand-in of the kit (module tests) can run it
+    let built = false, wait = null;
+    const fill = () => { if (built) return; built = true; wait?.remove(); body.append(...draw(p)); };
+    const waiting = () => { wait = ui.h("p", { class: "muted small" }, "Working it out…"); body.append(wait); };
+    return { el, fill, waiting };
+  }
+
+  let doorSlot = null;
+  const refreshDoor = () => { if (doorSlot) doorSlot.replaceChildren(...[door()].filter(Boolean)); };
+
+  return {
+    stage, at, deep: at !== null && !landing,
+    /** The short page's parts this device keeps at hand, in the page's own order; nothing when none is kept. */
+    kept() {
+      const kept = depth.kept(page);
+      const mine = own.filter((p) => kept.includes(p.key) && p.keep !== false);
+      if (!mine.length) return null;
+      return ui.h("div", { class: "dp-root dp-kept" }, style(), mine.map((p) => { const s = section(p, true); s.fill(); return s.el; }));
+    },
+    door() { doorSlot = ui.h("div", {}, door()); return doorSlot; },
+    /** Draw the deeper page into `root`; returns the page's cleanup. */
+    page(root) {
+      const wrap = ui.h("div", { class: "dp-root dp-page" }, style(),
+        ui.h("a", { class: "dp-back", href: shortHref, "data-back": true }, `‹ ${title}`),
+        ui.h("section", { class: "card accent hero" }, ui.h("h1", {}, `${title}: the detail`), answer ? ui.h("p", { class: "lede" }, answer) : null));
+      const secs = own.map((p) => ({ p, ...section(p) }));
+      for (const s of secs) wrap.append(s.el);
+      if (pages.length) wrap.append(ui.h("section", { class: "card" }, ui.h("h2", {}, "Related pages"), ui.h("ul", { class: "page-list" }, pages.map((p) => rowFor(p.ask, `#/${p.to}`)))));
+      if (stage === "first") wrap.append(ui.h("p", { class: "muted small" }, `Once your plan is finished, the ${title} page lists these one by one under "${HEADING}".`));
+      root.append(wrap);
+      // build: everything light at once; a heavy part when it is asked for, comes near the screen, or the page is printed
+      const wanted = secs.find((s) => s.p.key === at) ?? null;
+      let io = null;
+      const fillAll = () => { for (const s of secs) s.fill(); };
+      try { io = typeof IntersectionObserver === "function" ? new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) { secs.find((s) => s.el === e.target)?.fill(); io.unobserve(e.target); } }, { rootMargin: "600px 0px" }) : null; } catch { io = null; }
+      for (const s of secs) { if (!s.p.heavy || s === wanted || !io) s.fill(); else { s.waiting(); io.observe(s.el); } }
+      try { globalThis.addEventListener?.("beforeprint", fillAll); } catch { }
+      // land on the part the address names: below the top bar, focus on its heading's section, the named box ringed
+      const fresh = ctx.route && typeof ctx.route === "object" ? !landed.has(ctx.route) : true;
+      if (fresh && ctx.route && typeof ctx.route === "object") landed.add(ctx.route);
+      if (wanted && fresh) {
+        const land = () => {
+          try { wanted.el.scrollIntoView({ block: "start" }); wanted.el.focus({ preventScroll: true }); } catch { }
+          const box = query.show ? wanted.el.querySelector?.(`[name="${query.show}"]`) : null;
+          const ring = box?.closest?.("label") ?? null;
+          if (ring) { ring.classList.add("dp-ring"); try { ring.scrollIntoView({ block: "center" }); box.focus({ preventScroll: true }); } catch { } setTimeout(() => ring.classList.remove("dp-ring"), 2200); }
+        };
+        if (typeof requestAnimationFrame === "function") requestAnimationFrame(land); else land();
+      }
+      return () => { try { io?.disconnect(); globalThis.removeEventListener?.("beforeprint", fillAll); } catch { } };
+    },
+  };
+}
