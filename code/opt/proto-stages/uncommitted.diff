new file mode 100644
index 0000000..0522bbf
--- /dev/null
+++ b/core/depth.js
@@ -0,0 +1,60 @@
+// core/depth.js -- how far this household has come, and what this device keeps at hand. PURE apart from the device's
+// storage, which is guarded: import-safe in Node (tests), and with storage blocked or erased everything reads as
+// "the short page" (docs/DESIGN_LOG.md 2026-11-12: simple first, detail on request).
+//
+//   stage      "first"   until the path to Your plan was finished once (plan.guide.journeys.plan.finishedAt, written by
+//                        the path's own Next button, never by opening or closing anything);
+//              "deeper"  from then on, for good: a step that new data adds later never takes the offers away again.
+//                        A device may also ask for the offers before the plan is finished (Settings).
+//   kept       the parts of deeper pages a person asked to keep on the short page, per page, on this device only.
+//
+// Nothing here is plan data and nothing here changes a number: compute.js never sees it.
+export const DEPTH_KEY = "planner.depth";
+/** The path's id in modules/overview/guide/journeys.js (PATH_ID). tests/depth.test.mjs holds the two equal. */
+export const PATH = "plan";
+
+let mem = { kept: {}, offer: false };
+const store = () => { try { return globalThis.localStorage ?? null; } catch { return null; } };
+const clean = (kept) => Object.fromEntries(Object.entries(kept && typeof kept === "object" ? kept : {})
+  .map(([page, keys]) => [page, [...new Set((Array.isArray(keys) ? keys : []).filter((k) => typeof k === "string" && k))]])
+  .filter(([page, keys]) => /^[a-z0-9-]+\/[a-z0-9-]+$/.test(page) && keys.length));
+function load() {
+  try { const v = JSON.parse(store()?.getItem(DEPTH_KEY) || "null"); mem = v && typeof v === "object" ? { kept: clean(v.kept), offer: v.offer === true } : { kept: {}, offer: false }; }
+  catch { mem = { kept: {}, offer: false }; }
+}
+function save() {
+  try { if (!mem.offer && !Object.keys(mem.kept).length) store()?.removeItem(DEPTH_KEY); else store()?.setItem(DEPTH_KEY, JSON.stringify(mem)); } catch { }
+}
+load();
+
+export const depth = {
+  /** Read the device's choice again (boot, a test that changed storage). */
+  init() { load(); return this; },
+  /** This device asked for the "Go deeper" lists before the plan is finished. */
+  get offer() { return mem.offer; },
+  setOffer(on) { mem.offer = !!on; save(); },
+  /** The parts of `page` ("group/id") kept on its short page on this device, in the order they were kept. */
+  kept(page) { return [...(mem.kept[page] ?? [])]; },
+  isKept(page, key) { return (mem.kept[page] ?? []).includes(key); },
+  keep(page, key, on = true) {
+    const now = (mem.kept[page] ?? []).filter((k) => k !== key);
+    if (on) now.push(key);
+    if (now.length) mem.kept[page] = now; else delete mem.kept[page];
+    save();
+  },
+  /** Every kept part on this device: [{ page, key }] (Settings lists them and can put them all back). */
+  all() { return Object.entries(mem.kept).flatMap(([page, keys]) => keys.map((key) => ({ page, key }))); },
+  clear() { mem.kept = {}; save(); },
+};
+
+/** "first" | "deeper" for this plan on this device (see the header). */
+export function stageOf(plan, { offer = mem.offer } = {}) {
+  return offer || !!plan?.guide?.journeys?.[PATH]?.finishedAt ? "deeper" : "first";
+}
+
+/** What the address asks for: null (the short page), "" (the deeper page, from its top) or a part's key. */
+export function partAsked(query) {
+  if (!query || typeof query !== "object" || !("deeper" in query)) return null;
+  const v = String(query.deeper ?? "");
+  return v === "1" || v === "all" ? "" : v;
+}
diff --git a/core/ui/deeper.js b/core/ui/deeper.js
