 let pending = null;
 let justSaved = false;   // a save on this page: its green line says the new tax (the headline is far above the boxes)
 let figsOpen = false;    // "Figures the plan cannot see" stays open on the redraw after its own save (it shut and the screen jumped)
 
+const SOURCES = "Brackets and deductions: the IRS's yearly tables (Revenue Procedures 2023-34 for 2024, 2024-40 for 2025 and 2025-32 for 2026) with the 2025 tax law's changes. The Social Security pay limit comes from the Social Security Administration. Later years grow with inflation from the last table; the limits the law fixes in dollars stay put.";
