diff --git a/tests/depth.test.mjs b/tests/depth.test.mjs
new file mode 100644
index 0000000..d131fd3
--- /dev/null
+++ b/tests/depth.test.mjs
@@ -0,0 +1,117 @@
+// tests/depth.test.mjs -- core/depth.js (the stage and what a device keeps) and core/ui/deeper.js (the short page's door,
+// the deeper page) with the repo's stand-in DOM. Prototype of the STAGES design (design-stages.md).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import "../qa/fixtures/fake-dom.mjs";
+import { textOf } from "../qa/fixtures/fake-dom.mjs";
+
+// a stand-in for the device's storage, before core/depth.js is imported
+const mem = new Map();
+globalThis.localStorage = { getItem: (k) => (mem.has(k) ? mem.get(k) : null), setItem: (k, v) => mem.set(k, String(v)), removeItem: (k) => mem.delete(k) };
+const { depth, stageOf, partAsked, PATH, DEPTH_KEY } = await import("../core/depth.js");
+const { deeper, HEADING, ROWS } = await import("../core/ui/deeper.js");
+const { PATH_ID, passStep, pathSummary } = await import("../modules/overview/guide/compute.js");
+const { familyPlan } = await import("../qa/fixtures/family-plan.mjs");
+const { migrate } = await import("../core/schema/migrate.js");
+const ui = await import("../core/ui/dom.js");
+const TODAY = "2026-11-12";
+
+test("the stage is the path's own finish mark: 'first' until the path was finished once, 'deeper' for good after", () => {
+  assert.equal(PATH, PATH_ID);
+  const plan = migrate(familyPlan(TODAY));
+  assert.equal(stageOf(plan), "first");
+  for (let i = 0; i < 30 && !pathSummary(plan, { today: TODAY }).complete; i++) {
+    const s = pathSummary(plan, { today: TODAY });
+    const open = s.parts.find((p) => !p.passed) ?? s.parts.find((p) => !p.done);
+    passStep(plan, open.key, TODAY, []);
+  }
+  assert.equal(stageOf(plan), "deeper");
+  // a step that new data adds later does not take the offers away again
+  plan.debts.push({ id: "d-new", name: "New card", type: "credit_card", balance: 900, rate: 0.24, minPayment: 30 });
+  assert.equal(stageOf(plan), "deeper");
+  assert.equal(stageOf({}), "first"); assert.equal(stageOf(null), "first");
+  assert.equal(stageOf({}, { offer: true }), "deeper");
+});
+
+test("what a device keeps: per page, in order, never in the plan; an erased or broken store reads as nothing kept", () => {
+  depth.clear(); depth.setOffer(false);
+  assert.equal(mem.has(DEPTH_KEY), false);
+  depth.keep("taxes/federal", "how"); depth.keep("taxes/federal", "numbers"); depth.keep("taxes/federal", "how");
+  assert.deepEqual(depth.kept("taxes/federal"), ["numbers", "how"]);
+  assert.deepEqual(JSON.parse(mem.get(DEPTH_KEY)), { kept: { "taxes/federal": ["numbers", "how"] }, offer: false });
+  depth.keep("taxes/federal", "numbers", false);
+  assert.deepEqual(depth.all(), [{ page: "taxes/federal", key: "how" }]);
+  mem.set(DEPTH_KEY, "{not json"); depth.init();
+  assert.deepEqual(depth.all(), []); assert.equal(depth.offer, false);
+  mem.set(DEPTH_KEY, JSON.stringify({ kept: { "x": ["a"], "taxes/federal": "how", "debt/payoff": ["order", 3, ""] }, offer: "yes" })); depth.init();
+  assert.deepEqual(depth.all(), [{ page: "debt/payoff", key: "order" }]); assert.equal(depth.offer, false);
+  depth.clear();
+  assert.equal(mem.has(DEPTH_KEY), false);
+});
+
+test("the address names the level", () => {
+  assert.equal(partAsked({}), null); assert.equal(partAsked(undefined), null);
+  assert.equal(partAsked({ deeper: "1" }), ""); assert.equal(partAsked({ deeper: "" }), "");
+  assert.equal(partAsked({ deeper: "how" }), "how");
+});
+
+const parts = (built) => [
+  { key: "a", title: "Part A", ask: "What is A?", status: () => "three lines", build: () => { built.push("a"); return ui.h("p", {}, "A's body"); } },
+  { key: "b", title: "Part B", ask: "What is B?", status: () => ({ text: "set by you", yours: 2 }), build: () => { built.push("b"); return ui.h("p", {}, "B's body"); } },
+  { key: "c", title: "Part C", ask: "What is C?", status: () => ({ alert: "A figure in here is missing" }), build: () => { built.push("c"); return ui.h("p", {}, "C's body"); } },
+  { key: "d", title: "Part D", ask: "What is D?", when: () => false, build: () => { built.push("d"); return ui.h("p", {}, "D"); } },
+  { key: "e", title: "Part E", ask: "What is E?", build: () => { built.push("e"); return ui.h("p", {}, "E"); } },
+  { key: "f", title: "Part F", ask: "What is F?", build: () => { built.push("f"); return ui.h("p", {}, "F"); } },
+  { key: "g", title: "Part G", ask: "What is G?", build: () => { built.push("g"); return ui.h("p", {}, "G"); } },
+  { to: "taxes/brackets", ask: "A deeper page" },
+];
+const ctxFor = (plan, query = {}) => ({ ui, plan, route: { query } });
+
+test("the short page: nothing is built; one quiet row before the plan is finished, the card of questions after", () => {
+  depth.clear(); depth.setOffer(false);
+  const built = [];
+  const first = deeper(ctxFor({}), "x/y", parts(built), { title: "Page", subject: "this thing" });
+  assert.equal(first.deep, false); assert.equal(first.stage, "first"); assert.equal(first.kept(), null);
+  const door = first.door();
+  assert.deepEqual(built, []);
+  const links = door.querySelectorAll("a");
+  assert.equal(links.length, 1);
+  assert.equal(links[0].getAttribute("href"), "#/x/y?deeper=1");
+  assert.match(textOf(door.querySelector("ul")), /^More about this thing ›/);
+  assert.match(textOf(door.querySelector("ul")), /needs a look/);   // something of the person's that needs a look is said on the one row too
+  const after = deeper(ctxFor({ guide: { journeys: { plan: { finishedAt: TODAY } } } }), "x/y", parts(built), { title: "Page", subject: "this thing" });
+  const card = after.door();
+  assert.equal(card.querySelector("h2").textContent, HEADING);
+  const rows = card.querySelectorAll("a").map((a) => textOf(a));
+  assert.equal(rows.length, ROWS + 1);
+  assert.ok(rows.some((r) => r.startsWith("What is B? ›") && r.includes("2 yours")), "the part with the person's own figures is shown");
+  assert.ok(rows.some((r) => r.startsWith("What is C? ›") && r.includes("needs a look")), "the part that needs a look is shown");
+  assert.equal(rows.at(-1), "All 7 ›");
+  assert.ok(!rows.some((r) => r.includes("What is D?")), "a part with nothing to show is not offered");
+  assert.deepEqual(built, []);
+});
+
+test("the deeper page: every part that applies is a section; the frame's keys ride along on the way back", () => {
+  depth.clear();
+  const built = [];
+  const d = deeper(ctxFor({}, { deeper: "b", guide: "plan", step: "taxes" }), "x/y", parts(built), { title: "Page", answer: "The answer." });
+  assert.equal(d.deep, true); assert.equal(d.at, "b");
+  const root = ui.h("div");
+  const done = d.page(root);
+  assert.equal(typeof done, "function");
+  assert.deepEqual(built, ["a", "b", "c", "e", "f", "g"]);
+  assert.equal(root.querySelector("a").getAttribute("href"), "#/x/y?guide=plan&step=taxes");
+  assert.match(textOf(root), /Page: the detail The answer\. Part A A's body/);
+  assert.equal(root.querySelectorAll("section").filter((s) => s.className.includes("dp-part")).length, 6);
+});
+
+test("a kept part is drawn on the short page and leaves the door; unticking puts it back", () => {
+  depth.clear(); depth.keep("x/y", "a");
+  const built = [];
+  const d = deeper(ctxFor({ guide: { journeys: { plan: { finishedAt: TODAY } } } }), "x/y", parts(built), { title: "Page" });
+  const kept = d.kept();
+  assert.deepEqual(built, ["a"]);
+  assert.match(textOf(kept), /Part A A's body Keep this on the Page page/);
+  assert.ok(!d.door().querySelectorAll("a").some((a) => textOf(a).startsWith("What is A?")));
+  depth.clear();
+});
