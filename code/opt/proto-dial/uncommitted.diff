diff --git a/core/detail.js b/core/detail.js
new file mode 100644
index 0000000..6c75f09
--- /dev/null
+++ b/core/detail.js
@@ -0,0 +1,43 @@
+// core/detail.js -- how much of a page this device opens by itself.
+//
+// THE SHORT VIEW (the default, and what a new, a private or an erased browser shows): the answer first, every optional
+// part shut. EVERYTHING OPEN: the same page with its optional parts already open. A page can be set apart from the
+// device ("Show everything on this page"). Nothing here is plan data: it never reaches compute.js, the PC or another
+// device, and losing it costs one tap. Only core/ui/more.js and the Settings page read it; a view never does (the same
+// markup is drawn either way, see docs/CONVENTIONS.md "Optional parts").
+// Dependency-free and import-safe in Node (tests): storage may throw, and then the choice lives for the visit.
+export const DETAIL_KEY = "planner.detail";
+
+let state = null;                  // { all: boolean, pages: { "group/id": boolean } }
+const store = () => { try { return globalThis.localStorage ?? null; } catch { return null; } };
+const save = () => { try { if (!state.all && !Object.keys(state.pages).length) store()?.removeItem(DETAIL_KEY); else store()?.setItem(DETAIL_KEY, JSON.stringify(state)); } catch { } };
+
+/** "all" | "short" | null from an address search string ("?detail=all"): for screenshots and checks, like ?view=. */
+export function parseDetail(search) {
+  try { const v = new URLSearchParams(String(search ?? "")).get("detail"); return v === "all" || v === "short" ? v : null; } catch { return null; }
+}
+function load() {
+  if (state) return state;
+  state = { all: false, pages: {} };
+  try {
+    const raw = JSON.parse(store()?.getItem(DETAIL_KEY) ?? "null");
+    if (raw && typeof raw === "object") state = { all: raw.all === true, pages: raw.pages && typeof raw.pages === "object" ? Object.fromEntries(Object.entries(raw.pages).filter(([, v]) => typeof v === "boolean")) : {} };
+  } catch { state = { all: false, pages: {} }; }
+  let asked = null;
+  try { asked = parseDetail(globalThis.location?.search ?? ""); } catch { }
+  if (asked) { state = { all: asked === "all", pages: {} }; save(); }
+  return state;
+}
+
+export const detail = {
+  /** The device's choice: true = everything open on every page. */
+  get all() { return load().all; },
+  /** Does this page start with its optional parts open? The page's own choice first, then the device's. */
+  wants(key) { const s = load(); return key && Object.hasOwn(s.pages, key) ? s.pages[key] : s.all; },
+  /** The device's choice (Settings). It clears every page's own choice, so one switch sets every page. No event: Settings says it in place. */
+  setAll(on) { state = { all: !!on, pages: {} }; save(); },
+  /** One page's own choice. Stored only where it differs from the device's. No redraw: the row opens the parts in place. */
+  setPage(key, on) { const s = load(); if (!key) return; if (!!on === s.all) delete s.pages[key]; else s.pages[key] = !!on; save(); },
+  /** Tests only: forget the memory copy so the next read loads again. */
+  forget() { state = null; },
+};
diff --git a/core/ui/more.js b/core/ui/more.js
new file mode 100644
index 0000000..18dcd9f
--- /dev/null
+++ b/core/ui/more.js
@@ -0,0 +1,135 @@
+// core/ui/more.js -- the one way a page draws a part that is optional: shut in the short view, one quiet tap away.
+//
+//   import { part, parts, optional, moreRows, pageRow } from "../../../core/ui/more.js";
+//   parts(ctx, part(ctx, "numbers", "3 more numbers", tiles), part(ctx, "how", "How this is worked out", walk, { status: "11 lines" }))
+//
+// One markup, two starting states. A part is a native <details class="fold"> with a fixed title, a status and a marker.
+// Whether it STARTS open is decided here and nowhere else:
+//   1. a reason the page gives (opts.open: "error", "saved", "landing", "empty") always opens it;
+//   2. the address names it (?show=<id or a key it holds>): it opens;
+//   3. otherwise the dial: the page's own "Show everything on this page", else the device's "How much detail";
+//   4. otherwise shut.
+// What the person then opens or shuts by hand is kept by the shell's place memory (core/place.js, wave 1), which reads
+// the fold as it was drawn; this file keeps nothing about single folds.
+// A view never reads the dial and never draws different words for it. No DOM is touched at import (Node tests).
+import { detail } from "../detail.js";
+
+const builders = new WeakMap();   // a lazy part -> the function that builds its body
+/** The kinds the dial opens. "item" (one fold per person, month, word), "tech" and "note" are never opened by it. */
+export const DIAL_KINDS = ["numbers", "how", "figures", "options", "rows", "own"];
+const dialed = (kind) => DIAL_KINDS.includes(kind);
+export const pageKeyOf = (ctx) => (ctx?.module?.group ? `${ctx.module.group}/${ctx.module.id}` : ctx?.route?.group ? `${ctx.route.group}/${ctx.route.id}` : "");
+
+/** The status line of a part, one spelling each (docs/CONVENTIONS.md "Optional parts"): what is wrong first, then what is the person's. */
+export function statusWords({ error = 0, missing = 0, set = 0, guess = false, status = "" } = {}) {
+  if (error) return "needs a look";
+  if (missing) return `${missing} to fill in`;
+  const mine = set ? (set === true ? "set by you" : `${set} set by you`) : "";
+  return [mine, status || (guess && !mine ? "our guess" : "")].filter(Boolean).join(" · ");
+}
+
+/**
+ * part(ctx, kind, title, body, opts) -> <details>. `body`: nodes, or a function that builds them the first time the part
+ * opens (for a part that costs work). opts: { status, set, guess, missing, error, open, id, holds: [keys], card }.
+ */
+export function part(ctx, kind, title, body, opts = {}) {
+  const { ui } = ctx;
+  const show = ctx.route?.query?.show;
+  const landed = !!show && (show === opts.id || (opts.holds ?? []).includes(show));
+  const reason = opts.error ? "error" : opts.open ? String(opts.open === true ? "page" : opts.open) : landed ? "landing" : "";
+  const byDial = !reason && dialed(kind) && detail.wants(pageKeyOf(ctx));
+  const lazy = typeof body === "function";
+  const host = ui.h("div", { class: "fold-body" });
+  let built = false;
+  const build = () => { if (built) return; built = true; host.replaceChildren(...[].concat(lazy ? body() : body).flat(Infinity).filter((x) => x !== null && x !== undefined && x !== false)); };
+  const words = statusWords(opts);
+  const d = ui.h("details", { class: opts.card ? "card fold fold-card" : "fold", open: reason || byDial ? true : null, dataset: { more: kind, ...(reason ? { why: reason } : {}), ...(opts.id ? { moreId: opts.id } : {}) } },
+    // the summary stays a block and an inner span is the row: VoiceOver on an iPhone loses "collapsed" on some other displays
+    ui.h("summary", { style: { display: "block" } }, ui.h("span", { style: { display: "flex", alignItems: "center", gap: "10px", minHeight: "32px" } },
+      ui.h("span", { class: "fold-title" }, title), words ? ui.h("span", { class: "fold-status" }, words) : null, ui.h("span", { class: "fold-chev", "aria-hidden": "true" }, "›"))),
+    host);
+  if (!lazy || reason) build();
+  else if (byDial) { host.append(ui.h("p", { class: "muted small", "aria-busy": "true" }, "Working this out…")); setTimeout(build, 0); }   // the answer paints first
+  if (lazy) d.addEventListener("toggle", () => { if (d.open || d.hasAttribute?.("open")) build(); });
+  if (lazy) builders.set(d, build);   // printing builds it directly: a toggle event comes too late for the print
+  // a box that fails inside a shut part opens it (the browser cannot focus a box it cannot show)
+  d.addEventListener("invalid", () => { d.open = true; }, true);
+  return d;
+}
+
+/** The row that opens or shuts every optional part of this page at once, on this device. Shown where a page has two or more. */
+export function pageRow(ctx) {
+  const { ui } = ctx;
+  const key = pageKeyOf(ctx);
+  const on = detail.wants(key);
+  const box = ui.h("input", { type: "checkbox", checked: on ? true : null });
+  const hint = ui.h("a", { class: "small", href: "#/system/settings", hidden: !(on && !detail.all), style: { alignItems: "center", minHeight: "44px" } }, "On this phone only. To open every page like this: Settings ›");
+  const sync = () => { const show = box.checked && !detail.all; hint.hidden = !show; hint.style.display = show ? "inline-flex" : "none"; };
+  sync();
+  const row = ui.h("div", { dataset: { moreRow: key } }, ui.h("label", { class: "toggle-row" }, box, ui.h("span", { class: "toggle-text" }, "Show everything on this page")), hint);
+  box.addEventListener("change", () => {
+    const want = box.checked;
+    detail.setPage(key, want);
+    const page = row.closest("[data-page]") ?? row.parentNode;
+    for (const d of page?.querySelectorAll?.("details") ?? []) {
+      if (!dialed(d.dataset?.more)) continue;
+      // shutting never hides an error, or typing that is not saved yet
+      if (!want && (d.dataset.why === "error" || [...(d.querySelectorAll?.("input, select, textarea") ?? [])].some((c) => (c.type === "checkbox" ? c.checked !== c.defaultChecked : c.tagName !== "SELECT" && c.value !== c.defaultValue)))) continue;
+      d.open = want;
+    }
+    sync();
+    ctx.announce?.(want ? "Everything on this page is open." : "This page shows the short view again.");
+  });
+  return row;
+}
+
+/** One card that holds a page's optional parts as quiet rows, with the page row at its foot when there are two or more. */
+export function parts(ctx, ...list) {
+  const { ui } = ctx;
+  const rows = list.flat(Infinity).filter(Boolean);
+  const many = rows.filter((d) => dialed(d.dataset?.more)).length >= 2;
+  return ui.h("section", { class: "card" }, ui.h("div", { class: "folds" }, rows), many ? ui.h("div", { style: { borderTop: "1px solid var(--line)", marginTop: "2px", paddingTop: "2px" } }, pageRow(ctx)) : null);
+}
+
+/**
+ * optional(ctx, form, keys, { names }) -> the form. Moves the named boxes of a built ui.form into one part,
+ * "Optional details", directly above its button. The boxes stay inside the same <form>, so Save reads them the same
+ * way open or shut. A required box may not be moved (it throws: a shut part cannot hold a must-fill box).
+ */
+export function optional(ctx, form, keys, { names = "", title = "Optional details" } = {}) {
+  const fields = [];
+  for (const k of keys) {
+    const c = [...form.querySelectorAll("input, select, textarea")].find((x) => x.getAttribute("name") === k);
+    if (!c) continue;
+    if (c.hasAttribute("required")) throw new Error(`optional(): "${k}" is a must-fill box; it stays on the first view`);
+    const label = c.closest("label");
+    if (label) fields.push({ c, label });
+  }
+  if (!fields.length) return form;
+  const filled = fields.filter(({ c }) => (c.getAttribute("type") === "checkbox" ? false : String(c.value ?? "").trim() !== "")).length;
+  const actions = form.querySelector(".form-actions");
+  for (const f of fields) f.label.remove();
+  const p = part(ctx, "options", title, fields.map((f) => f.label), { status: filled ? `${filled} filled in` : names });
+  p.style.gridColumn = "1 / -1";
+  if (actions) { actions.remove(); form.append(p, actions); } else form.append(p);
+  return form;
+}
+
+/** A list that shows its first rows and keeps the rest behind "N more <noun>" (never a cut to hide a single row). */
+export function moreRows(ctx, items, draw, { first = 6, noun = "rows", cls = "records" } = {}) {
+  const { ui } = ctx;
+  if (items.length <= first + 1) return ui.h("ul", { class: cls }, items.map(draw));
+  const rest = items.slice(first);
+  return ui.h("div", {}, ui.h("ul", { class: cls }, items.slice(0, first).map(draw)),
+    part(ctx, "rows", `${rest.length} more ${noun}`, () => ui.h("ul", { class: cls }, rest.map(draw))));
+}
+
+// printing: a shut <details> prints nothing. Open every part for the print and shut it again after (the person's own
+// taps are kept by the shell, which listens for taps on a summary, not for these).
+try {
+  if (typeof addEventListener === "function" && typeof document !== "undefined" && document.querySelectorAll) {
+    let shutForPrint = [];
+    addEventListener("beforeprint", () => { shutForPrint = [...document.querySelectorAll("#content details:not([open])")]; for (const d of shutForPrint) { builders.get(d)?.(); d.open = true; } });
+    addEventListener("afterprint", () => { for (const d of shutForPrint) d.open = false; shutForPrint = []; });
+  }
+} catch { }
