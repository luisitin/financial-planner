@@ -0,0 +1,190 @@
+// core/ui/more.js -- optional detail, drawn one way (design rule 2026-11-12: simple first, detail on request).
+//
+// A PART is a piece of a page that starts shut and opens in place: a native <details> with a fixed title, a status line
+// that says what it holds, and a body. A view calls part(ctx, {...}) instead of writing <details> by hand.
+//
+//   import { part, rest, moreOptions, statusOf, opened } from "../../../core/ui/more.js";
+//   root.append(part(ctx, { id: "numbers", kind: "more", n: 3, noun: "numbers", body: () => tiles }));
+//
+// What it does for every part, so no view has to:
+//   - one markup (title in .fold-title, status in .fold-status, marker aria-hidden, summary stays display:block);
+//   - remembers what the person opened or shut ON THIS DEVICE, per part (never in the plan), and draws it that way the
+//     next time, across a redraw, Back, a reload and another day; only the person's own tap on the summary is recorded;
+//   - opens by itself when it holds something to fix (an invalid box, `fix`), when the page says so (`open: true`: the
+//     part just saved, a landing) or when the address names it (#/group/id?open=<id>); none of these is remembered;
+//   - says in its status when it holds something of the person's ("2 set by you") or something to fix ("1 to fix");
+//   - builds a heavy body only when first opened (`lazy: true`); everything else is in the page from the start, so the
+//     browser's find-in-page can open it;
+//   - opens every shut part while the browser prints, and shuts them again after.
+//
+// Dependency-free and import-safe in Node (tests): every browser call is guarded; storage may throw (a private window,
+// a sandboxed frame) and then the memory lives for the session only.
+
+const SANDBOX = (() => { try { return new URLSearchParams(globalThis.location?.search ?? "").has("sandbox"); } catch { return false; } })();
+export const OPENED_KEY = SANDBOX ? "planner.opened.sandbox" : "planner.opened";
+export const KEEP_DAYS = 90;        // a part nobody has looked at for this long goes back to how the page draws it
+const MAX_PARTS = 300;
+/** The kinds whose open or shut state is kept on the device. An item of a list (a person, a month) and technical details are not. */
+export const KEPT = new Set(["more", "own", "figures", "how", "options"]);
+export const TITLES = { how: "How this is worked out", own: "Set my own numbers", figures: "The figures", options: "More options", tech: "Show details" };
+
+const storage = () => { try { return globalThis.localStorage ?? null; } catch { return null; } };
+const today = () => Math.floor(Date.now() / 864e5);
+let mem = null;                     // { "group/id#part": [1 | 0, day] }
+function load() {
+  if (mem) return mem;
+  mem = {};
+  try {
+    const raw = JSON.parse(storage()?.getItem(OPENED_KEY) ?? "null");
+    if (raw && raw.fmt === 1 && raw.parts && typeof raw.parts === "object") {
+      const now = today();
+      for (const [k, v] of Object.entries(raw.parts)) if (Array.isArray(v) && (v[0] === 1 || v[0] === 0) && now - Number(v[1]) <= KEEP_DAYS) mem[k] = [v[0], Number(v[1])];
+    }
+  } catch { mem = {}; }
+  return mem;
+}
+function save() {
+  const keys = Object.keys(mem);
+  if (keys.length > MAX_PARTS) for (const k of keys.sort((a, b) => mem[a][1] - mem[b][1]).slice(0, keys.length - MAX_PARTS)) delete mem[k];
+  try { if (Object.keys(mem).length) storage()?.setItem(OPENED_KEY, JSON.stringify({ fmt: 1, parts: mem })); else storage()?.removeItem(OPENED_KEY); } catch { }
+}
+/** What this device remembers about the parts a person opened or shut. Never in the plan. */
+export const opened = {
+  /** true (they opened it), false (they shut it) or null (nothing remembered: draw it as the page designs it). */
+  get(page, id) {
+    const v = load()[`${page}#${id}`];
+    if (!v) return null;
+    if (v[1] !== today()) { v[1] = today(); save(); }   // seen today: at most one write a day per part
+    return v[0] === 1;
+  },
+  /** The person's own choice. The same as the page's design is not worth keeping: the entry goes. */
+  set(page, id, open, designed = false) {
+    load();
+    if (!!open === !!designed) delete mem[`${page}#${id}`]; else mem[`${page}#${id}`] = [open ? 1 : 0, today()];
+    save();
+  },
+  /** How many parts stay open on this device because the person opened them. */
+  count() { return Object.values(load()).filter((v) => v[0] === 1).length; },
+  /** Forget everything: every page opens as it is designed again. */
+  clear() { mem = {}; save(); },
+  /** For tests. */
+  _reset() { mem = null; },
+};
+
+const pageOf = (ctx) => (ctx?.module ? `${ctx.module.group}/${ctx.module.id}` : ctx?.route ? `${ctx.route.group}/${ctx.route.id}` : "page");
+
+/** The one status line of a part: what it holds, and whether any of it is the person's or needs a look. */
+export function statusOf({ says = "", set = 0, guess = 0, missing = false, fix = 0 } = {}) {
+  if (fix > 0) return `${fix} to fix`;
+  if (missing) return "not set yet";
+  const mine = set > 0 ? `${set} set by you` : "";
+  // one short line (20 characters): the person's own state comes before the description, never after an ellipsis
+  if (mine) return says && `${says} · ${mine}`.length <= STATUS_MAX ? `${says} · ${mine}` : mine;
+  if (says) return says;
+  return guess > 0 ? (guess === 1 ? "our guess" : `${guess} our guesses`) : "";
+}
+export const STATUS_MAX = 20;
+
+const landed = new WeakSet();       // route objects whose ?open= has been used (once per arrival, not on the redraw after a save)
+
+/**
+ * part(ctx, { id, kind, title?, n?, noun?, says?, set?, guess?, missing?, fix?, open?, card?, lazy?, body })
+ *   id     stable name of the part on its page (the memory's key, and the ?open= landing)
+ *   kind   "more" ("3 more numbers": pass n and noun) | "own" | "figures" | "how" | "options" | "item" | "tech"
+ *   title  only for "item", "tech" and for an "own" part on a page that has several (then it names what is inside)
+ *   says   the status in plain words ("standard is better", "$400,000"); set/guess/missing/fix add the person's state
+ *   open   true: the page needs it open now (just saved, a landing); never remembered. false or absent: shut by design
+ *   card   true: a whole folded card; false: a row inside a card
+ *   body   nodes, or a function that returns them (called at once, or with lazy: true when first opened)
+ */
+export function part(ctx, o) {
+  const h = ctx.ui.h, page = pageOf(ctx), kind = o.kind ?? "more";
+  const title = kind === "more" ? `${o.n} more ${o.noun}` : o.title ?? TITLES[kind] ?? "";
+  const status = statusOf(o);
+  const asked = ctx.route?.query?.open === o.id && !landed.has(ctx.route);
+  if (asked) landed.add(ctx.route);
+  const forced = o.open === true || o.fix > 0 || asked;
+  const kept = KEPT.has(kind) ? opened.get(page, o.id) : null;
+  const designed = false;
+  const isOpen = forced || (kept ?? designed);
+  const bodyEl = h("div", { class: "fold-body" });
+  let built = false;
+  const build = () => { if (built) return; built = true; const b = typeof o.body === "function" ? o.body() : o.body; bodyEl.append(...[b].flat(Infinity).filter((x) => x !== null && x !== undefined && x !== false)); };
+  if (!o.lazy || isOpen) build();
+  const sum = h("summary", { style: { display: "block" } }, h("span", { style: { display: "flex", alignItems: "center", gap: "10px", minHeight: "32px" } },
+    h("span", { class: "fold-title" }, title), status ? " " : null, status ? h("span", { class: "fold-status" }, status) : null, h("span", { class: "fold-chev", "aria-hidden": "true" }, "\u203a")));
+  // the summary stays a block and an inner span is the row: VoiceOver on an iPhone drops "collapsed / expanded" for some
+  // other displays of <summary> (research 1.6); no heading inside it
+  const el = h("details", { class: o.card === false ? "fold" : "card fold fold-card", open: isOpen ? true : null, dataset: { part: o.id, kind } }, sum, bodyEl);
+  // only the person's own tap (or Enter on the summary) is a choice; a script, the printer, find-in-page and a failing
+  // box also open parts and must never be remembered. Every DOM call is optional: three module tests draw views with a
+  // text-only stand-in for the kit, whose nodes have no listeners.
+  sum.addEventListener?.("click", (e) => {
+    if (e && e.isTrusted === false) return;
+    setTimeout(() => { const now = el.open ?? el.hasAttribute?.("open"); if (now) build(); if (KEPT.has(kind)) opened.set(page, o.id, !!now, designed); }, 0);
+  });
+  el.addEventListener?.("toggle", () => { if (el.open) build(); });
+  // a box inside that fails its check opens the part (a required box in a shut <details> cannot take the focus, and the
+  // browser then stops the save without a word)
+  el.addEventListener?.("invalid", () => { build(); el.open = true; }, true);
+  if (asked) setTimeout(() => { try { el.scrollIntoView?.({ block: "start" }); } catch { } }, 0);
+  return el;
+}
+
+/**
+ * parts(ctx, ...list): the optional parts of a page as quiet rows of ONE card (hairlines between), in the fixed order
+ * more, own / figures, how. Five folded cards in a column read as a wall of doors (prototype, 2026-11-12); one card of
+ * rows reads as "there is more here if you want it". Each entry is what part() takes; nothing is drawn for an empty list.
+ */
+const ORDER = { more: 0, own: 1, figures: 1, how: 2 };
+export function parts(ctx, ...list) {
+  const items = list.flat().filter(Boolean).sort((a, b) => (ORDER[a.kind ?? "more"] ?? 3) - (ORDER[b.kind ?? "more"] ?? 3));
+  if (!items.length) return null;
+  return ctx.ui.h("section", { class: "card", dataset: { parts: "" } }, ctx.ui.h("div", { class: "folds" }, items.map((o) => part(ctx, { ...o, card: false }))));
+}
+
+/**
+ * rest(ctx, { id, items, row, first = 6, noun, list = "records" }): the first rows, then "N more <noun>" for the others.
+ * Never hides fewer than three rows (a cut that hides one row saves nothing and looks like the whole list).
+ * `row(item)` returns an <li>. Returns [ <ul>, part ] or [ <ul> ].
+ */
+export function rest(ctx, { id, items, row, first = 6, noun, list = "records", card = false }) {
+  const h = ctx.ui.h;
+  if (items.length < first + 3) return [h("ul", { class: list }, items.map(row))];
+  const tail = items.slice(first);
+  return [h("ul", { class: list }, items.slice(0, first).map(row)),
+    part(ctx, { id, kind: "more", n: tail.length, noun, card, lazy: tail.length > 40, body: () => h("ul", { class: list }, tail.map(row)) })];
+}
+
+/**
+ * moreOptions(ctx, form, { id, keys, says }): move the named boxes of a built ui.form into one "More options" part just
+ * above its buttons. `says` names what is inside ("category, start and end dates"); when a moved box holds something
+ * the status says "2 set by you" instead. A moved box that fails its check opens the part. What Save writes is the
+ * same with the part open or shut: only boxes whose blank means "none" or "the usual" may be moved (never a box that
+ * shows one of our grey guesses: docs/CONVENTIONS.md "Guesses", a guess is written only from a box the person saw).
+ */
+export function moreOptions(ctx, form, { id = "options", keys, says = "", blank = {} }) {
+  const labels = [], setCount = { n: 0 };
+  for (const k of keys) {
+    const c = form.querySelector(`[name="${k}"]`); const label = c?.closest("label");
+    if (!label) continue;
+    labels.push(label);
+    const v = c.type === "checkbox" ? (c.checked ? "1" : "") : String(c.value ?? "");
+    if (v !== String(blank[k] ?? "")) setCount.n++;
+  }
+  if (!labels.length) return null;
+  const actions = form.querySelector(".form-actions");
+  const p = part(ctx, { id, kind: "options", card: false, says: setCount.n ? "" : says, set: setCount.n, body: labels });
+  if (p.style) p.style.gridColumn = "1 / -1";
+  const b = p.querySelector?.(".fold-body"); if (b) Object.assign(b.style, { display: "grid", gap: "12px", paddingTop: "8px" });   // the form's own spacing
+  form.append(p); if (actions) form.append(actions);   // the part sits last before the buttons (append moves both)
+  return p;
+}
+
+// Printing: a shut <details> does not print. Open every shut one in the page while the browser prints, shut them after.
+// Nothing here is a tap, so nothing is remembered.
+if (typeof addEventListener === "function" && typeof document !== "undefined" && document.querySelectorAll) {
+  let forPrint = [];
+  addEventListener("beforeprint", () => { forPrint = [...document.querySelectorAll("#content details:not([open])")]; for (const d of forPrint) d.open = true; });
+  addEventListener("afterprint", () => { for (const d of forPrint) d.open = false; forPrint = []; });
+}
