+  const ordered = list.rows.map((r, i) => ({ r, i })).sort((x, y) => (y.r.first ? 1 : 0) - (x.r.first ? 1 : 0) || (y.r.ask ? 1 : 0) - (x.r.ask ? 1 : 0) || groupOf(x.r) - groupOf(y.r) || Math.abs(y.r.score) - Math.abs(x.r.score) || x.i - y.i).map((x) => x.r);
