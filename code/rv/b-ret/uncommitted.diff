+// tests/levers-fix1.test.mjs -- "What this rests on" and the money left over after the review of 2026-11-12 (fix round 1; the
+// findings are named by the critics' ids). The left-over is the Dashboard's own figure (M1); a row into the bank is money that
+// stays in checking and savings (M3); a row above what is left over, or into an account that is gone, is said and put right in
+// one tap (B3, B7); what the person said reads the same whether or not it is being asked about again (N6); the answer after a
+// save never says "still" over an answer that lasts, and never a "was" the page did not say (P6, M7); the match the card tries
+// stays pay-the-tax-later and stays our guess (B5, M5). Invented households: the phone-built ones, the 14 qa households, the
+// family, Sam.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import * as LV from "../modules/retirement/levers.js";
+import * as C from "../modules/retirement/contributions/compute.js";
