Subject: [PATCH 18/22] fixup! Wave 1, forms: every form speaks in plain words
 at the box

fixup! Wave 1, forms: every form speaks in plain words at the box

A row that clicks itself from its own Enter or Space handler is a key open: the cursor goes into the form it opens.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FKTjPFbzEx2ZvP4BhqKEiS
---
 core/ui/dom.js | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/core/ui/dom.js b/core/ui/dom.js
index 76fa235..02b3b1a 100644
--- a/core/ui/dom.js
+++ b/core/ui/dom.js
@@ -544,6 +544,10 @@ if (DOC && !document.documentElement.dataset.formsKit) {
     held.clear();
   };
   document.addEventListener("pointerdown", (e) => { down = true; clearTimeout(downTimer); lastDown = { el: e.target, t: performance.now() }; }, true);
+  // Enter or Space being handled: a row's own keydown that clicks the row (`e.currentTarget.click()`) is a key open too
+  // (forms1 K4: rows opened from the keyboard got no cursor in their form)
+  let keying = false;
+  document.addEventListener("keydown", (e) => { if (!e.isTrusted || (e.key !== "Enter" && e.key !== " ")) return; keying = true; setTimeout(() => { keying = false; }, 0); }, true);
   document.addEventListener("pointerup", () => { clearTimeout(downTimer); downTimer = setTimeout(flush, 400); }, true);
   document.addEventListener("pointercancel", () => { clearTimeout(downTimer); downTimer = setTimeout(flush, 0); }, true);
   document.addEventListener("click", (e) => {
@@ -553,10 +557,10 @@ if (DOC && !document.documentElement.dataset.formsKit) {
     const sf = sub?.type === "submit" ? formOf(sub) : null;
     if (sf) readyBoxes(elementsOf(sf));
     // what was activated inside the page, for this task only (a keyboard click only when a person pressed a key: a page
-    // that calls el.click() must not raise the keyboard)
+    // that calls el.click() must not raise the keyboard, unless it does so from that key's own handler)
     const el = closestOf(e.target, "button, a, summary, [role=button], li, tr, [data-key]");
     if (el && el.closest("#content")) {
-      act = noteOf(el, e.isTrusted && e.detail === 0);
+      act = noteOf(el, (e.isTrusted && e.detail === 0) || (!e.isTrusted && keying));
       setTimeout(() => { if (act?.el === el) act = null; }, 0);
     }
     down = false; clearTimeout(downTimer);
-- 
