From e7c1281 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 06:57:31 +0000
Subject: [PATCH 07/22] fixup! Wave 1, place: Back returns to the same spot;
 typing and open sections are kept

---
 core/app.js                   |  2 +-
 core/router.js                | 14 ++++++++++----
 tests/router-replace.test.mjs | 22 ++++++++++++++++++++++
 3 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/core/app.js b/core/app.js
index ecd54db..2fac5a3 100644
--- a/core/app.js
+++ b/core/app.js
@@ -425,7 +425,7 @@ async function show(route, { keepScroll = false, entry = null } = {}) {
   if (!keepScroll) {
     document.querySelector(".save-echo")?.remove();   // a note belongs to the page it was said on
     if (entry?.from && drawnSeq === seq - 1) place.leave(entry.from.n, entry.from.href);   // the entry left, with its address
-    if (entry?.kind === "new" && !entry.replaced) place.forgetAfter(entry.from?.n ?? entry.n - 1);   // Forward can no longer reach those
+    if (entry?.kind === "new" && !entry.replaced && !entry.away) place.forgetAfter(entry.from?.n ?? entry.n - 1);   // Forward can no longer reach those (a Back onto another visit's entry: it still can)
     place.visit(entry, place.pageKeyOf(location.hash));
     // Back, Forward, Reload: the record of this entry (not while the "changed in two places" bar asks to be seen)
     rec = entry && entry.kind !== "new" && !document.getElementById("sync-bar") ? place.recordOf(entry.n, location.href) : null;
diff --git a/core/router.js b/core/router.js
index 481bad1..294b4d8 100644
--- a/core/router.js
+++ b/core/router.js
@@ -85,7 +85,10 @@ const len = () => { try { return history.length; } catch { return 0; } };
 function sync(first = false, pop = false) {
   const s = st(), mine = s.v === visit && Number.isFinite(s.n), l = mine ? s.l ?? 0 : 0;
   if (pop && mine) traversed = true;   // a Back or Forward onto a numbered or layer entry
-  if (!first && cur && mine && s.n === cur.n) {   // the same entry: only what is open over the page changed
+  // the same entry, only what is open over the page changed. The address must be the one on screen too: two entries can
+  // carry one number (an entry stamped by a visit whose number was lost: storage blocked, or the version before), and a
+  // Forward onto the other one is drawn, never skipped (regress-break 1)
+  if (!first && cur && mine && s.n === cur.n && location.hash === cur.hash) {
     if (l === cur.l) return;
     if (stepping) stepping--;
     else if (l < layers.length) { for (const x of layers.splice(l).reverse()) { try { x.close(); } catch (e) { console.warn(e); } } }
@@ -93,9 +96,12 @@ function sync(first = false, pop = false) {
     if (l > layers.length) { stepping++; history.back(); }   // an entry for something no longer open
     return;
   }
-  const replaced = !mine && !first && isReplace({ had: !!cur, mark, traversed, len: len(), lenRef });
+  // an entry another visit numbered, reached by Back or Forward, is never a replace of the one on screen (a link's new
+  // entry has no number yet): it gets a number of its own
+  const away = pop && Number.isFinite(s.n);
+  const replaced = !mine && !first && !away && isReplace({ had: !!cur, mark, traversed, len: len(), lenRef });
   const top = Math.max(0, ...Object.keys(trail).map(Number));
-  const stamp = stampOf(s, { v: visit, cur, top, first, replaced, away: pop && s.n !== undefined });
+  const stamp = stampOf(s, { v: visit, cur, top, first, replaced, away });
   const n = stamp.n, hash = location.hash;
   if (stamp.stamped) {
     try { history.replaceState(stamp.state, ""); } catch { /* Safari's rate limit: the entry stays unnumbered */ }
@@ -113,7 +119,7 @@ function sync(first = false, pop = false) {
   for (const x of layers.splice(0).reverse()) { try { x.close(); } catch (e) { console.warn(e); } }   // leaving the page closes what was open over it
   cur = { n, l, hash, href: location.href };
   lastKind = stamp.kind;
-  handler?.(parse(hash), { ...router.entry(), from, replaced: !!stamp.replaced });
+  handler?.(parse(hash), { ...router.entry(), from, replaced: !!stamp.replaced, away: stamp.stamped && away });
   if (l > 0) { stepping++; history.back(); }   // arrived on an entry that stood for something open (a reload with the menu open)
 }
 // a page's own history.replaceState keeps the entry's number (state null or without it) and the trail follows the address
diff --git a/tests/router-replace.test.mjs b/tests/router-replace.test.mjs
index 0883ac4..eef7f61 100644
--- a/tests/router-replace.test.mjs
+++ b/tests/router-replace.test.mjs
@@ -102,4 +102,26 @@ test("a walk: links, Back, a page's own replace, Forward, a layer and the ways b
   assert.equal(router.back("#/c/three?from=plan"), true, "the page just behind (from does not count)"); await tick();
   assert.deepEqual([last().page, last().kind], ["c/three", "back"]);
   assert.equal(router.back("#/a/one"), false, "not just behind: the link is followed");
+
+  // regress-break 1: entries another visit numbered (sessionStorage blocked: a new visit at every load; or the version before
+  // wave 1, whose entries carry no number). Back onto one must not take the number of the entry on screen, and Forward
+  // from it draws the page its address names
+  location.hash = "#/f/six"; await tick();
+  location.hash = "#/g/seven"; await tick();
+  history.entries[history.i - 1].state = { v: "a-visit-whose-id-was-lost", n: 2, l: 0 };
+  const onScreen = last().n;
+  history.back(); await tick();
+  assert.equal(last().page, "f/six"); assert.notEqual(last().n, onScreen, "a number of its own, not the one on screen");
+  let before = seen.length;
+  history.forward(); await tick();
+  assert.equal(seen.length, before + 1, "Forward draws"); assert.equal(last().page, "g/seven");
+  // an entry with no number at all (the version before): even when it is taken for the entry on screen, Forward still draws
+  history.entries[history.i - 1].state = null;
+  history.back(); await tick();
+  assert.equal(last().page, "f/six");
+  before = seen.length;
+  history.forward(); await tick();
+  assert.equal(seen.length, before + 1, "Forward draws the page of its address"); assert.equal(last().page, "g/seven");
+  history.back(); await tick();
+  assert.equal(last().page, "f/six", "and Back again");
 });
-- 
