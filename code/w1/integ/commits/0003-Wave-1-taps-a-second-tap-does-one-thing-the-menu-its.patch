+// core/address.js -- an address that names no page (wave 1, track "taps"; the touch stress test of 2026-11-11, finding
+// j-navigator/N2: a mistyped or old address showed the Dashboard under the wrong address, with no word about it). PURE:
+// tests/address.test.mjs. core/app.js draws the card ("Page not found", "<Page> is switched off") from what this says.
+
+/**
+ * Why an address shows no page, or null when it shows one.
+ *   route  { group, id } (core/router.js parse)
+ *   opts   { modules: Map("group/id" -> manifest), groups: GROUPS, userView: bool, enabled(m), offered(m), sourceOf(m) }
+ *          ready(m): the page is built (not a "soon" page)
+ * Returns { kind: "unknown", group } for no such page, and for a page the household's view does not offer (a "soon"
+ * page, a builder's page, one that needs the helper when it does not answer: design log 2026-11-06); `group` is its
+ * topic when the address names one (else null). { kind: "off", key, by } for a page switched off, `by` "properties"
+ * when the computer's settings switched it off (it cannot be turned on here), else "device". A page that only waits for
+ * your computer (waitsForComputer) is not missing: it opens and says so itself.
+ */
+export function missing(route, { modules, groups = [], userView = true, enabled = () => true, offered = () => true, sourceOf = () => "default", ready = (m) => m.status !== "planned" } = {}) {
+  const key = `${route?.group}/${route?.id}`;
+  const m = modules?.get?.(key) ?? null;
+  const topic = groups.find((g) => g.id === String(route?.group ?? "").toLowerCase()) ?? null;
+  if (!m) return { kind: "unknown", group: topic };
+  if (userView && !offered(m) && !waitsForComputer(m, ready)) return { kind: "unknown", group: topic };
+  if (!enabled(m)) return { kind: "off", key, by: sourceOf(m) === "properties" ? "properties" : "device" };
+  return null;
+}
+
+/**
+ * A page the household's view offers whenever your computer answers (`requires: "pc"`: Backups, the record of changes,
+ * bank statements), built and not a builder's page. While the computer does not answer it is not in the menu, but its
+ * address still opens it, and the page says "Not connected to your computer" itself, in the household's words: a
+ * reload on it, or the computer going to sleep while it is open, must not turn it into "Page not found". The gate
+ * before main moves opens two of them on the phone's site (qa/flows/static-stall.mjs "no-pc").
+ */
+export const waitsForComputer = (m, ready = (x) => x.status !== "planned") => !!m && m.requires === "pc" && !m.builderOnly && !!ready(m);
+
+/** The address in the wrong case (#/cashflow/Income) is the page it names: the corrected route, or null when there is nothing to fix. */
+export function fixCase(route, has) {
+  const key = `${route?.group}/${route?.id}`;
+  if (has(key)) return null;
+  const group = String(route?.group ?? "").toLowerCase(), id = String(route?.id ?? "").toLowerCase();
+  return has(`${group}/${id}`) ? { ...route, group, id } : null;
+}
