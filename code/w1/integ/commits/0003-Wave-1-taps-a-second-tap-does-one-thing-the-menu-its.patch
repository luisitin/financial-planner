+    gesture = { why, t: tap.t, x: tap.x, y: tap.y, hash: tap.hash, rev: tap.rev, c, used: false };
+    if (why && why !== "stale" && last) last.burst = tap.t;   // a thumb still tapping the same spot: one gesture
