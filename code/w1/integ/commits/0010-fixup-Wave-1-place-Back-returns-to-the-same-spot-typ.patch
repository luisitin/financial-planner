From f5b25da Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 07:04:43 +0000
Subject: [PATCH 10/22] fixup! Wave 1, place: Back returns to the same spot;
 typing and open sections are kept

---
 core/place.js        | 5 +++--
 tests/place.test.mjs | 2 ++
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/core/place.js b/core/place.js
index 7fa8421..975ce77 100644
--- a/core/place.js
+++ b/core/place.js
@@ -41,10 +41,11 @@ export function pickForm(rec, fks) {
   if (same.length > 1 && same.length === rec.of && same[rec.i] !== undefined) return same[rec.i];
   return -1;
 }
-/** A notice can be read: at least 60% of it (or 48 px of it) between the top bar and the bottom edge. */
+/** A notice can be read: its first line is not under the top bar (6 px of slack), and at least 60% of it (or 48 px of
+ * it) is between the top bar and the bottom edge. A line half under the bar is not read (place NP4). */
 export function seenEnough(r, top, bottom) {
   const vis = Math.min(r.bottom, bottom) - Math.max(r.top, top);
-  return vis > 0 && (vis >= 0.6 * (r.bottom - r.top) - 0.5 || vis >= 48);
+  return vis > 0 && r.top >= top - 6 && (vis >= 0.6 * (r.bottom - r.top) - 0.5 || vis >= 48);
 }
 /** How long the bottom note stays: by its length, longer with a way on, longer for an error; 4 to 10 s. */
 export const echoStay = (chars, ways = 0, bad = false) => Math.round(Math.min(10000, Math.max(bad ? 6000 : 4000, 2000 + 55 * chars + (ways ? 2000 : 0))));
diff --git a/tests/place.test.mjs b/tests/place.test.mjs
index a76f1e3..3f4d010 100644
--- a/tests/place.test.mjs
+++ b/tests/place.test.mjs
@@ -127,6 +127,8 @@ test("a confirmation is seen when most of it is between the top bar and the bott
   assert.equal(seenEnough({ top: 800, bottom: 900 }, 56, 844), false);
   assert.equal(seenEnough({ top: 700, bottom: 1000 }, 56, 844), true, "144 px of a tall notice");
   assert.equal(seenEnough({ top: -400, bottom: -300 }, 56, 844), false);
+  assert.equal(seenEnough({ top: 20, bottom: 114 }, 56, 844), false, "place NP4: 62% shows, but its first line is under the bar");
+  assert.equal(seenEnough({ top: 52, bottom: 146 }, 56, 844), true, "4 px under the bar: read");
 });
 test("the bottom note stays 4 to 10 s by its length, longer with a way on, at least 6 s for an error", () => {
   assert.equal(echoStay(10), 4000);
-- 
