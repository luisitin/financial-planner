+  assert.equal(last().page, "f/six");
+  before = seen.length;
+  history.forward(); await tick();
+  assert.equal(seen.length, before + 1, "Forward draws the page of its address"); assert.equal(last().page, "g/seven");
+  history.back(); await tick();
