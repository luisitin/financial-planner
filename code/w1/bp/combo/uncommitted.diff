@@ -0,0 +1,171 @@
+// tests/place.test.mjs -- the pure rules of the shell's place and typing memory (core/place.js) and of the history entries
+// (core/router.js): which entry a way back returns to, how an arrival is told apart, which typing goes back where, when a
+// confirmation counts as seen, how long the bottom note stays. Both files import in Node with no DOM and no storage.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { sameEntry, backSteps, kindOf, stampOf, hashOf } from "../core/router.js";
+
+// ---------------------------------------------------------------- router
+test("sameEntry: the same page and its query keys; from does not count; a month the entry lacks is its own", () => {
+  assert.equal(sameEntry("#/overview/plan", "#/overview/plan"), true);
+  assert.equal(sameEntry("#/overview/plan?from=plan", "#/overview/plan"), true, "from only says how a page was reached");
+  assert.equal(sameEntry("#/overview/plan", "#/overview/plan?from=dash"), true);
+  assert.equal(sameEntry("#/overview/monthly-review?month=2026-10", "#/overview/monthly-review"), true, "the check-in opened without ?month showed that month");
+  assert.equal(sameEntry("#/overview/monthly-review?month=2026-10", "#/overview/monthly-review?month=2026-11"), false, "October is not November");
+  assert.equal(sameEntry("#/overview/quick?q=retire", "#/overview/quick"), false, "any other key the entry lacks is another page");
+  assert.equal(sameEntry("#/a/b", "#/a/c"), false);
+  assert.equal(sameEntry("#/a/b/x", "#/a/b"), false, "the rest counts");
+  assert.equal(sameEntry("http://h/?sandbox=1#/a/b", "#/a/b"), true, "a full address is read by its hash");
+  assert.equal(hashOf("http://h/?sandbox=1#/a/b?x=1"), "#/a/b?x=1");
+});
+test("backSteps: one step when the page is just behind, a Next-result walk, else 0", () => {
+  const t = { 1: { h: "#/overview/dashboard", p: null }, 2: { h: "#/overview/monthly-review", p: 1 }, 3: { h: "#/balance/update?from=review&review=2026-10", p: 2 } };
+  assert.equal(backSteps(t, 3, "#/overview/monthly-review?month=2026-10"), 1, "the check-in step's way back");
+  assert.equal(backSteps(t, 3, "#/overview/dashboard"), 0, "not just behind, and no walk: follow the link");
+  assert.equal(backSteps({}, 1, "#/a/b"), 0, "a fresh tab");
+  assert.equal(backSteps({ 1: { h: "#/a/b", p: null } }, 1, "#/a/b"), 0, "nothing behind the first entry");
+  const oct = { 4: { h: "#/overview/monthly-review?month=2026-11", p: null }, 5: { h: "#/balance/update?from=review&review=2026-10", p: 4 } };
+  assert.equal(backSteps(oct, 5, "#/overview/monthly-review?month=2026-10"), 0, "October is not November");
+  // Your plan, then two "Next result" pages: the way back walks over the whole walk
+  const walk = { 1: { h: "#/overview/plan", p: null }, 2: { h: "#/retirement/projection?from=plan", p: 1 }, 3: { h: "#/taxes/federal?from=plan", p: 2 } };
+  assert.equal(backSteps(walk, 3, "#/overview/plan"), 2);
+  assert.equal(backSteps(walk, 2, "#/overview/plan"), 1);
+  // a page opened another way in between stops the walk
+  const mixed = { 1: { h: "#/overview/plan", p: null }, 2: { h: "#/retirement/projection?from=plan", p: 1 }, 3: { h: "#/cashflow/income", p: 2 }, 4: { h: "#/taxes/federal?from=plan", p: 3 } };
+  assert.equal(backSteps(mixed, 4, "#/overview/plan"), 0);
+  // at most 10 steps
+  const long = { 0: { h: "#/overview/plan", p: null } };
+  for (let i = 1; i <= 12; i++) long[i] = { h: `#/x/p${i}?from=plan`, p: i - 1 };
+  assert.equal(backSteps(long, 10, "#/overview/plan"), 10);
+  assert.equal(backSteps(long, 12, "#/overview/plan"), 0);
+});
+test("kindOf: a numbered entry at the first draw is a reload; smaller is Back, larger Forward", () => {
+  assert.equal(kindOf(true, 4, null), "reload");
+  assert.equal(kindOf(false, 4, null), "new");
+  assert.equal(kindOf(false, 2, 4), "back");
+  assert.equal(kindOf(false, 5, 4), "forward");
+});
+test("stampOf: keeps a page's own state, numbers after the entry on screen, keeps it on a replace, another visit is new", () => {
+  const s = stampOf({ suFrom: "q2" }, { v: "t1", cur: { n: 3 }, top: 7 });
+  assert.deepEqual(s.state, { suFrom: "q2", v: "t1", n: 4, l: 0 }); assert.equal(s.kind, "new"); assert.equal(s.p, 3);
+  assert.deepEqual(stampOf({ v: "t1", n: 2, suFrom: "q1" }, { v: "t1", cur: { n: 4 } }), { state: { v: "t1", n: 2, suFrom: "q1" }, n: 2, kind: "back", stamped: false });
+  assert.equal(stampOf({ v: "t1", n: 2 }, { v: "t1", first: true }).kind, "reload");
+  const other = stampOf({ v: "t0", n: 2 }, { v: "t1", cur: { n: 4 }, top: 6, away: true });
+  assert.deepEqual([other.n, other.kind, other.p], [7, "new", null], "an entry of another visit (sessionStorage gone, history kept) is new and has nothing behind it");
+  const rep = stampOf(null, { v: "t1", cur: { n: 4 }, replaced: true });
+  assert.deepEqual([rep.n, rep.replaced, rep.p], [4, true, null]);
+  assert.deepEqual([stampOf(null, { v: "t1", top: 9 }).n, stampOf(null, { v: "t1", top: 9 }).p], [10, null], "a first draw follows every number known");
+  assert.equal(stampOf("junk", { v: "t1" }).n, 1);
+});
+
+// ---------------------------------------------------------------- place (pure rules; the DOM side is walked with the kit)
+import { shape, secretText, pageKeyOf, neverKept, boxVerdict, pickForm, seenEnough, echoStay, fresh, prune, pruneTyping, planSig, usedOnLeave, calmArgs, boxName, wrapScrolls, scrolls, roomDue, DAY } from "../core/place.js";
+
+test("figures leave the words, so a row is the same row after a save", () => {
+  assert.equal(shape("Store card $1,201"), shape("Store card $1,202"));
+  assert.equal(shape("Raises and promotions 3.0% ›"), "raises and promotions #");
+  assert.notEqual(shape("Edit Ana's salary"), shape("Edit Bo's salary"), "two rows' forms differ by their title");
+});
+test("a box's own name: its visible label first, then aria-label, then placeholder", () => {
+  assert.equal(boxName("Amount", "Amount: $4,100 a month", "e.g. 4,000"), "amount", "pages rewrite aria-label as you type");
+  assert.equal(boxName("", "Pasted CSV", "...or paste"), "pasted csv");
+  assert.equal(boxName("", null, "Search"), "search");
+});
+test("boxes for keys, tokens, passwords, secrets and PINs are never kept; ordinary words are", () => {
+  for (const t of ["apiKey", "API key (for another service)", "Access token", "password", "Passcode", "pass code", "passphrase", "secret", "PIN", "bankPin"]) assert.equal(secretText(t), true, t);
+  for (const t of ["Transit pass a month", "Monkey bars", "Spending in retirement, a month", "Pinned note", "Keystone fund", "Passport renewal"]) assert.equal(secretText(t), false, t);
+  assert.equal(secretText(null, "", undefined, "Name", "apiKey"), true);
+  assert.equal(neverKept("#/system/settings"), true);
+  assert.equal(neverKept("#/cashflow/income"), false);
+});
+test("typing is kept under the page and only the query keys that change what it holds", () => {
+  assert.equal(pageKeyOf("#/balance/update?from=review&review=2026-11"), "#/balance/update");
+  assert.equal(pageKeyOf("#/balance/update"), "#/balance/update");
+  assert.equal(pageKeyOf("#/cashflow/expenses?guide=plan&step=month"), "#/cashflow/expenses");
+  assert.equal(pageKeyOf("#/overview/monthly-review?month=2026-10"), "#/overview/monthly-review?month=2026-10", "a month changes what the page holds");
+  assert.equal(pageKeyOf("#/balance/liabilities/abc?add=1"), "#/balance/liabilities/abc");
+  assert.equal(pageKeyOf("#/balance/net-worth?edit=a1&back=overview/plan"), "#/balance/net-worth?edit=a1", "back only says where to go after");
+  assert.equal(pageKeyOf("#/x/y?b=2&a=1"), "#/x/y?a=1&b=2");
+  assert.equal(pageKeyOf("http://h/?sandbox=1#/x/y?view=all"), "#/x/y");
+});
+test("a box drawn again: put back, already back, or let go because its saved figure changed", () => {
+  assert.equal(boxVerdict("3,900", "9,999", "3,900"), "fill");
+  assert.equal(boxVerdict("3,900", "9,999", "9,999"), "same", "the page put it back itself (Get started, People): no cue");
+  assert.equal(boxVerdict("380,000", "391,000", "395,000"), "changed", "the house's value was saved elsewhere meanwhile");
+  assert.equal(boxVerdict("", "Weekend tutoring", ""), "fill");
+});
+test("which form a record names: the same identity, and twins only by position while their count is unchanged", () => {
+  assert.equal(pickForm({ fk: "a", i: 0, of: 1 }, ["b", "a", "c"]), 1);
+  assert.equal(pickForm({ fk: "a", i: 1, of: 2 }, ["a", "b", "a"]), 2, "Bo's W-4 is the second of two alike");
+  assert.equal(pickForm({ fk: "a", i: 0, of: 2 }, ["a", "b"]), -1, "one twin went: never a guess");
+  assert.equal(pickForm({ fk: "a", i: 0, of: 1 }, ["a", "a"]), -1, "a twin appeared: never a guess");
+  assert.equal(pickForm({ fk: "z", i: 0, of: 1 }, ["a"]), -1);
+});
+test("a confirmation is seen when most of it is between the top bar and the bottom edge", () => {
+  assert.equal(seenEnough({ top: 22, bottom: 70 }, 56, 844), false, "p-taxes/x-5: 14 px under a 56 px bar");
+  assert.equal(seenEnough({ top: 100, bottom: 160 }, 56, 844), true);
+  assert.equal(seenEnough({ top: 800, bottom: 900 }, 56, 844), false);
+  assert.equal(seenEnough({ top: 700, bottom: 1000 }, 56, 844), true, "144 px of a tall notice");
+  assert.equal(seenEnough({ top: -400, bottom: -300 }, 56, 844), false);
+});
+test("the bottom note stays 4 to 10 s by its length, longer with a way on, at least 6 s for an error", () => {
+  assert.equal(echoStay(10), 4000);
+  assert.equal(echoStay(100, 1), 9500);
+  assert.equal(echoStay(400, 2), 10000);
+  assert.equal(echoStay(10, 0, true), 6000);
+});
+test("records and typing are bounded: 60 entries, a day, 20 KB a page", () => {
+  const r = {}; for (let i = 1; i <= 70; i++) r[i] = { y: i };
+  assert.deepEqual(Object.keys(prune(r, 60)).map(Number).slice(0, 2), [11, 12]);
+  const now = Date.now();
+  assert.equal(fresh(now - DAY + 1000, now), true);
+  assert.equal(fresh(now - DAY - 1, now), false);
+  assert.equal(fresh(now + 5000, now), false, "a clock that went back is not fresh");
+  const t = { "#/a/b": { forms: { x: { at: now - 2 * DAY, boxes: [] } }, loose: [] }, "#/c/d": { forms: { y: { at: now, boxes: [{ v: "x".repeat(30000) }] } }, loose: [] }, "#/e/f": { forms: { z: { at: now, boxes: [{ v: "1" }] } }, loose: [] }, "#/g/h": { loose: [{ at: now - 2 * DAY }] } };
+  assert.deepEqual(Object.keys(pruneTyping(t, now)), ["#/e/f"]);
+});
+test("a store update that changed only the stamp is not a save", () => {
+  const a = { meta: { rev: "1" }, incomes: [{ amount: 1 }] };
+  assert.equal(planSig(a), planSig({ meta: { rev: "2", updatedAt: "x" }, incomes: [{ amount: 1 }] }));
+  assert.notEqual(planSig(a), planSig({ meta: { rev: "1" }, incomes: [{ amount: 2 }] }));
+});
+test("the save-and-leave rule: one act saved the plan and left the page, with no newer touch, within 1.5 s", () => {
+  assert.equal(usedOnLeave({ at: 1000, mark: 7 }, 1800, 7), true, "Import's button: saved, then Categorize");
+  assert.equal(usedOnLeave({ at: 1000, mark: 7 }, 1800, 8), false, "a newer touch: the leaving is another act");
+  assert.equal(usedOnLeave({ at: 1000, mark: 7 }, 2600, 7), false, "too late");
+  assert.equal(usedOnLeave(null, 1800, 7), false);
+});
+test("room borrowed under a page goes 600 ms after it last grew, never while the page says it is working out its answer", () => {
+  assert.equal(roomDue(700, false), true, "the page stopped growing: its real end may show");
+  assert.equal(roomDue(300, false), false, "it may still grow");
+  assert.equal(roomDue(5000, true), false, "\"Working it out...\" is on the screen: the answer will fill the room (Stress tests' Now chip)");
+  assert.equal(roomDue(601, false, 600), true);
+});
+test("reduced motion: a smooth scroll call becomes instant; everything else passes as it is", () => {
+  assert.deepEqual(calmArgs("scrollIntoView", [{ behavior: "smooth", block: "start" }], true), [{ behavior: "auto", block: "start" }]);
+  assert.deepEqual(calmArgs("scrollTo", [{ top: 5, behavior: "smooth" }], true), [{ top: 5, behavior: "auto" }]);
+  assert.deepEqual(calmArgs("scrollTo", [0, 40], true), [0, 40]);
+  assert.deepEqual(calmArgs("scrollIntoView", [{ behavior: "smooth" }], false), [{ behavior: "smooth" }]);
+  assert.deepEqual(calmArgs("scrollIntoView", [true], true), [true]);
+});
+test("the one wrapper of the scroll calls keeps this, every argument and the return value, and counts the page's calls", () => {
+  const seen = [];
+  const win = { scrollTo(...a) { seen.push([this, a]); return "w"; }, scrollBy() { return 1; }, scroll() { } };
+  const el = { scrollIntoView(...a) { seen.push([this, a]); return "e"; }, scrollTo() { }, scrollBy() { }, scroll() { } };
+  const html = { focus(...a) { seen.push([this, a]); return "f"; } };
+  const reduce = { matches: true };
+  wrapScrolls({ win, el, html, reduce });
+  wrapScrolls({ win, el, html, reduce });   // wrapped once only
+  const s0 = scrolls();
+  assert.equal(win.scrollTo(0, 120), "w");
+  assert.deepEqual(seen.at(-1), [win, [0, 120]]);
+  const node = Object.create(el);
+  assert.equal(node.scrollIntoView({ behavior: "smooth", block: "center" }), "e");
+  assert.equal(seen.at(-1)[0], node); assert.deepEqual(seen.at(-1)[1], [{ behavior: "auto", block: "center" }]);
+  assert.equal(scrolls(), s0 + 2);
+  const box = Object.create(html);
+  assert.equal(box.focus({ preventScroll: true }), "f");
+  assert.equal(scrolls(), s0 + 2, "a focus that does not scroll is not the page scrolling");
+  box.focus();
+  assert.equal(scrolls(), s0 + 3);
+});
diff --git a/tests/router-replace.test.mjs b/tests/router-replace.test.mjs
new file mode 100644
index 0000000..0883ac4
--- /dev/null
+++ b/tests/router-replace.test.mjs
@@ -0,0 +1,105 @@
+// tests/router-replace.test.mjs -- the router's history numbering in a pretend browser (core/router.js): a link is a new
+// entry, a page's own location.replace keeps the entry's number, Back and Forward and a reload are told apart, a layer
+// (the menu, an edit form) is one more entry that Back closes, and "‹ Back to ..." links go Back only when the page they
+// name is just behind. The pretend browser fires popstate then hashchange on a fragment navigation, as Chromium does.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { isReplace } from "../core/router.js";
+
+test("isReplace: a mark decides; else no traversal, the same length, under the cap", () => {
+  assert.equal(isReplace({ had: false, mark: "replace", traversed: false, len: 3, lenRef: 3 }), false, "the first entry is never a replace");
+  assert.equal(isReplace({ had: true, mark: "new", traversed: false, len: 3, lenRef: 3 }), false);
+  assert.equal(isReplace({ had: true, mark: "replace", traversed: true, len: 9, lenRef: 3 }), true);
+  assert.equal(isReplace({ had: true, mark: null, traversed: false, len: 3, lenRef: 3 }), true, "a page's own location.replace");
+  assert.equal(isReplace({ had: true, mark: null, traversed: false, len: 4, lenRef: 3 }), false, "a link grows the history");
+  assert.equal(isReplace({ had: true, mark: null, traversed: true, len: 3, lenRef: 3 }), false, "after a Back the length cannot tell");
+  assert.equal(isReplace({ had: true, mark: null, traversed: false, len: 50, lenRef: 50 }), false, "at the browser's cap a push keeps the length");
+});
+
+// ---------------------------------------------------------------- a pretend browser, just enough for the router
+const listeners = {};
+const fire = (type) => { for (const fn of listeners[type] ?? []) fn({ type }); };
+const store = new Map();
+globalThis.sessionStorage = { getItem: (k) => (store.has(k) ? store.get(k) : null), setItem: (k, v) => store.set(k, String(v)), removeItem: (k) => store.delete(k) };
+globalThis.addEventListener = (t, fn) => { (listeners[t] ??= []).push(fn); };
+const clicks = [];
+globalThis.document = { addEventListener: (t, fn) => { if (t === "click") clicks.push(fn); } };
+const ORIGIN = "http://x/";
+class History {
+  constructor() { this.entries = [{ url: ORIGIN + "#/overview/dashboard", state: null }]; this.i = 0; }
+  get length() { return this.entries.length; }
+  get state() { return this.entries[this.i].state; }
+  pushState(s, _t, u) { this.entries.splice(this.i + 1); this.entries.push({ url: u ? ORIGIN + u : this.entries[this.i].url, state: structuredClone(s) }); this.i++; }
+  replaceState(s, _t, u) { this.entries[this.i] = { url: u ? ORIGIN + u : this.entries[this.i].url, state: structuredClone(s) }; }
+  go(d) { const j = this.i + d; if (j < 0 || j >= this.entries.length) return; const was = location.hash; this.i = j; queueMicrotask(() => { fire("popstate"); if (location.hash !== was) fire("hashchange"); }); }
+  back() { this.go(-1); }
+  forward() { this.go(1); }
+}
+globalThis.History = History;
+globalThis.history = new History();
+const hashOfUrl = (u) => u.slice(u.indexOf("#"));
+globalThis.location = {
+  get hash() { return hashOfUrl(history.entries[history.i].url); },
+  set hash(h) { if (h === this.hash) return; history.entries.splice(history.i + 1); history.entries.push({ url: ORIGIN + h, state: null }); history.i++; queueMicrotask(() => { fire("popstate"); fire("hashchange"); }); },
+  get href() { return history.entries[history.i].url; },
+  search: "",
+  replace(h) { history.entries[history.i] = { url: ORIGIN + h, state: null }; queueMicrotask(() => { fire("popstate"); fire("hashchange"); }); },
+};
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a walk: links, Back, a page's own replace, Forward, a layer and the ways back", async () => {
+  const { router } = await import("../core/router.js");
+  const seen = [];
+  router.start((route, e) => seen.push({ page: `${route.group}/${route.id}`, n: e.n, kind: e.kind, from: e.from?.n ?? null, replaced: e.replaced }));
+  const last = () => seen.at(-1);
+  assert.deepEqual(last(), { page: "overview/dashboard", n: 1, kind: "new", from: null, replaced: false }, "the first draw of a fresh tab");
+  location.hash = "#/a/one"; await tick();
+  assert.equal(last().n, 2); assert.equal(last().kind, "new");
+  history.back(); await tick();
+  assert.deepEqual([last().n, last().kind], [1, "back"]);
+  location.hash = "#/b/two"; await tick();
+  assert.deepEqual([last().n, last().kind, last().replaced], [2, "new", false], "link, Back, link: 2, 1, 2 (the second link is not a replace)");
+  assert.equal(router.at(2).href, "#/b/two"); assert.equal(router.at(2).p, 1);
+  // a page replaces its own address (Get started's own ‹, the Ledger's deep link): the entry keeps its number and where it came from
+  location.replace("#/b/two-and-a-half"); await tick();
+  assert.deepEqual([last().n, last().replaced, last().page], [2, true, "b/two-and-a-half"]);
+  assert.equal(router.at(2).p, 1);
+  assert.equal(history.length, 2, "nothing was added");
+  // a state the page wrote without the numbers keeps them
+  history.replaceState(null, "", "#/b/two-and-a-half?x=1");
+  assert.equal(history.state.n, 2); assert.equal(router.at(2).href, "#/b/two-and-a-half?x=1", "the trail follows the address (touch)");
+  history.replaceState({ ...history.state, suFrom: "q3" }, "");
+  assert.equal(history.state.suFrom, "q3"); assert.equal(history.state.n, 2);
+  location.hash = "#/c/three"; await tick();
+  assert.deepEqual([last().n, last().from], [3, 2]);
+  history.back(); await tick(); history.forward(); await tick();
+  assert.deepEqual(seen.slice(-2).map((x) => [x.n, x.kind]), [[2, "back"], [3, "forward"]]);
+  // a layer: Back closes it, no redraw, the address stays
+  let closed = 0;
+  const drawn = seen.length;
+  const release = router.layer(() => { closed++; });
+  assert.equal(history.length, 4); assert.equal(history.state.l, 1); assert.equal(router.layersOpen(), 1);
+  history.back(); await tick();
+  assert.equal(closed, 1); assert.equal(seen.length, drawn, "no redraw"); assert.equal(location.hash, "#/c/three"); assert.equal(router.layersOpen(), 0);
+  release(); await tick();
+  assert.equal(history.i, 2, "release() after Back already closed it does nothing");
+  // a layer closed by itself steps off its entry; the next Back leaves the page
+  const r2 = router.layer(() => { closed++; });
+  r2(); await tick();
+  assert.equal(closed, 1, "release() does not call close()"); assert.equal(history.state.l ?? 0, 0); assert.equal(seen.length, drawn);
+  // Forward onto the entry of a layer no longer open is stepped off at once
+  history.forward(); await tick(); await tick();
+  assert.equal(history.state.l ?? 0, 0); assert.equal(seen.length, drawn);
+  // a link while a layer is open takes the layer's entry
+  router.layer(() => { closed++; });
+  router.open("#/d/four", { via: "menu" }); await tick();
+  assert.deepEqual([last().page, last().n, last().from], ["d/four", 4, 3]);
+  assert.equal(router.at(4).via, "menu"); assert.equal(closed, 2, "leaving the page closed what was open over it");
+  history.back(); await tick();
+  assert.deepEqual([last().page, last().n], ["c/three", 3], "Back from it reaches the page, not a menu's entry");
+  // ways back: the page just behind; along a Next-result walk; a page opened another way in between is a link
+  location.hash = "#/e/five"; await tick();
+  assert.equal(router.back("#/c/three?from=plan"), true, "the page just behind (from does not count)"); await tick();
+  assert.deepEqual([last().page, last().kind], ["c/three", "back"]);
+  assert.equal(router.back("#/a/one"), false, "not just behind: the link is followed");
+});
diff --git a/tests/search-words.test.mjs b/tests/search-words.test.mjs
new file mode 100644
index 0000000..deca8cc
--- /dev/null
+++ b/tests/search-words.test.mjs
@@ -0,0 +1,69 @@
+// tests/search-words.test.mjs -- wave 1 (the touch stress test, 2026-11-11, SH-SEARCH N5 and x-3): a word is found as a
+// whole word or at the start of a longer word, never inside a word; the page named for the word comes first
+// (core/search.js matchScore; matchRank keeps its levels as floor(matchScore)).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { matchRank, matchScore, hasWords } from "../core/search.js";
+
+const vehicles = { group: "property", id: "vehicles", title: "Vehicles", purpose: "What your cars cost to keep." };
+const career = { group: "career", id: "salary", title: "Career and pay", purpose: "Raises and job changes." };
+const medicare = { group: "retirement", id: "medicare", title: "Medicare and IRMAA", purpose: "When to sign up for Medicare." };
+const healthcare = { group: "retirement", id: "healthcare", title: "Healthcare before 65", purpose: "Health insurance between retiring and Medicare." };
+const cards = { group: "debt", id: "credit-cards", title: "Credit cards", purpose: "What each card costs." };
+const payoff = { group: "debt", id: "payoff", title: "Pay off debts", purpose: "Which debt first." };
+const consolidation = { group: "debt", id: "consolidation", title: "Consolidation", purpose: "Roll cards into one cheaper loan." };
+const wills = { group: "estate", id: "documents", title: "Estate documents", purpose: "Your will and power of attorney." };
+const projection = { group: "retirement", id: "projection", title: "Will the money last?", purpose: "Retirement year by year.", aliases: ["retirement", "retire", "when can I retire"] };
+const ss = { group: "retirement", id: "social-security", title: "Social Security", purpose: "What claiming at each age pays.", aliases: ["social security", "benefit at 62", "benefit at 70"] };
+const budget = { group: "cashflow", id: "budget", title: "Budget", purpose: "An envelope for each kind of spending.", aliases: ["budget", "envelopes"] };
+const expenses = { group: "cashflow", id: "expenses", title: "Expenses", purpose: "Your regular spending by category.", aliases: ["spending", "bills", "budget"] };
+const fiftyThirty = { group: "cashflow", id: "budget-percent", title: "Budget (50/30/20)", purpose: "Needs, wants and savings." };
+const contacts = { group: "household", id: "contacts", title: "Contacts", purpose: "Lists your advisor, accountant and insurers." };
+const papers = { group: "household", id: "documents", title: "Document vault index", purpose: "Where your papers are kept." };
+const calendar = { group: "household", id: "calendar", title: "Money calendar", purpose: "Bills, paydays and tax deadlines." };
+const settings = { group: "system", id: "settings", title: "Settings", purpose: "Turn pages on or off, download or restore a copy." };
+
+const order = (pages, q, topic = "") => pages.map((m) => ({ m, s: matchScore(m, topic, q) })).filter((x) => x.s >= 0).sort((a, b) => a.s - b.s).map((x) => x.m.id);
+
+test("a short word inside another word is not a hit ('car' in Medicare)", () => {
+  assert.equal(matchRank(medicare, "Retirement", "car"), -1);
+  assert.ok(matchRank(vehicles, "Property", "car") >= 0, "car finds Vehicles through 'cars' (the same stem)");
+});
+test("a whole word ranks before the start of a longer word ('car': Vehicles before Career)", () => {
+  assert.ok(matchScore(vehicles, "Property", "car") < matchScore(career, "Career", "car"));
+  assert.equal(matchRank(career, "Career", "car"), 0, "typing 'car' on the way to 'career' still finds it, lower down");
+});
+test("the page's own name beats the same word in one of its search phrases ('card')", () => {
+  assert.ok(matchScore(cards, "Debt", "card") < matchScore(payoff, "Debt", "card"));
+});
+test("a phrase that is exactly the word ranks first ('will': the wills page before Will the money last?)", () => {
+  assert.ok(matchScore(wills, "Estate", "will") < matchScore(projection, "Retirement", "will"));
+});
+test("the plain words a person types for the household and settings pages find them (who to call, papers, reminder, reset)", () => {
+  assert.equal(matchRank(contacts, "Household", "who to call"), 0);
+  assert.equal(matchRank(contacts, "Household", "phone"), 0);
+  assert.equal(matchRank(papers, "Household", "papers"), 0);
+  assert.equal(matchRank(calendar, "Household", "reminder"), 0);
+  assert.equal(matchRank(settings, "System", "reset"), 0);
+});
+test("hasWords: a topic name holds the word, or a word starting with it", () => {
+  assert.ok(hasWords("Career and income", "car"));
+  assert.ok(hasWords("Taxes", "tax"));
+  assert.ok(!hasWords("Medicare", "car"));
+});
+test("'budget': the page called Budget first, then the page whose phrase is the word, then a name holding it (breaker S5)", () => {
+  assert.deepEqual(order([fiftyThirty, expenses, budget], "budget"), ["budget", "expenses", "budget-percent"]);
+});
+test("'cards': a phrase word found only by its stem is not a name-level hit (Help's own directory order holds)", () => {
+  assert.deepEqual(order([payoff, consolidation], "cards"), ["consolidation", "payoff"]);
+  assert.equal(matchRank(payoff, "Debt", "cards"), 3, "Pay off debts is still found, lower down");
+});
+test("'health care' finds both health pages by name; 'care' alone finds them, never by the letters inside Medicare", () => {
+  assert.equal(matchRank(medicare, "Retirement", "health care"), 0);
+  assert.equal(matchRank(healthcare, "Retirement", "health care"), 0);
+  assert.equal(matchRank(medicare, "Retirement", "care"), 0, "through its phrase 'health care'");
+});
+test("'retire at 62' puts Will the money last? before Social Security (it found only Social Security)", () => {
+  assert.deepEqual(order([ss, projection], "retire at 62", "Retirement"), ["projection", "social-security"]);
+  assert.equal(matchRank(projection, "Retirement", "when can I stop working"), 0);
+});
diff --git a/tests/taps.test.mjs b/tests/taps.test.mjs
new file mode 100644
index 0000000..fb29557
--- /dev/null
+++ b/tests/taps.test.mjs
@@ -0,0 +1,96 @@
+// tests/taps.test.mjs -- the tap guard's decision (core/taps.js verdict): which second taps do nothing, and which taps
+// must always land. The cases are the ones the touch stress test of 2026-11-11 reproduced on a phone (theme SH-TAP).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { verdict, same, fieldText, NEAR_PX, SEE_MS, SPAN_MS } from "../core/taps.js";
+
+const sig = (id, tag, text, x, y, w = 120, h = 44) => ({ id, tag, text, x, y, w, h });
+const SAVE = sig(1, "BUTTON", "Save", 20, 600);
+const NAME = sig(2, "INPUT", "text|name||", 20, 540, 350);
+const first = (over = {}) => ({ t: 1000, x: 80, y: 622, hash: "#/cashflow/income", rev: 5, c1: SAVE, around: [SAVE, NAME], ...over });
+const tap = (over = {}) => ({ t: 1300, x: 82, y: 620, hash: "#/cashflow/income", rev: 5, c: SAVE, inPage: true, ...over });
+
+test("the first tap of a visit, and a tap with nothing before it, always land", () => {
+  assert.equal(verdict({ last: null, tap: tap() }), null);
+});
+test("a second tap on the very same control lands when nothing changed (a stepper, a box, a fold)", () => {
+  assert.equal(verdict({ last: first(), tap: tap() }), null);
+  assert.equal(verdict({ last: first(), tap: tap({ c: { ...SAVE, y: 580 } }) }), null, "the same node, moved (the keyboard opened): still the control that was tapped");
+});
+test("a second Add or Save on the same button after the first one changed the plan does nothing", () => {
+  assert.equal(verdict({ last: first(), tap: tap({ rev: 6 }) }), "repeat");
+  assert.equal(verdict({ last: first(), tap: tap({ rev: 6, c: sig(9, "BUTTON", "Save", 21, 601) }), drawnAt: 1080 }), "repeat", "the button redrawn where it was");
+});
+test("the next row's button sliding under the thumb after a remove does nothing (same words, same place, another row)", () => {
+  const notSub = sig(4, "BUTTON", "Not a subscription", 250, 300, 130);
+  const l = first({ c1: notSub, around: [notSub], x: 300, y: 320 });
+  assert.equal(verdict({ last: l, tap: tap({ x: 300, y: 320, rev: 6, c: sig(7, "BUTTON", "Not a subscription", 250, 300, 130) }), drawnAt: 1070 }), "repeat");
+});
+test("something else under the thumb after a redraw does nothing: a link, another form, a box that moved there", () => {
+  assert.equal(verdict({ last: first(), tap: tap({ rev: 6, c: sig(8, "A", "Open my payoff plan", 20, 598, 160) }), drawnAt: 1070 }), "changed");
+  assert.equal(verdict({ last: first(), tap: tap({ c: { ...NAME, y: 600 } }) }), "changed", "a neighbour that slid under the thumb (the browser scrolled to a box it rejected)");
+  assert.equal(verdict({ last: first(), tap: tap({ c: sig(11, "SECTION", "Over time", 0, 500, 390, 300) }) }), "changed", "plain page where the button was: swallowed too, it does nothing either way");
+});
+test("a neighbour that did not move is a meant tap, also after the plan changed and the page was redrawn", () => {
+  assert.equal(verdict({ last: first(), tap: tap({ y: 590, c: NAME }) }), null);
+  assert.equal(verdict({ last: first(), tap: tap({ y: 590, rev: 6, c: sig(12, "INPUT", "text|name||", 21, 541, 350) }), drawnAt: 1080 }), null);
+});
+test("a new address: the tap on the same spot does nothing, whatever is there (Continue under Continue)", () => {
+  assert.equal(verdict({ last: first(), tap: tap({ hash: "#/overview/setup/owe", c: sig(13, "BUTTON", "Save", 20, 600) }), drawnAt: 1100 }), "new-page");
+});
+test("far from the last tap, or after the time it takes to see the new screen, a tap always lands", () => {
+  assert.equal(verdict({ last: first(), tap: tap({ x: 80 + NEAR_PX + 1, rev: 6, c: sig(8, "A", "x", 0, 0) }), drawnAt: 1070 }), null);
+  assert.equal(verdict({ last: first(), tap: tap({ t: 1000 + SEE_MS, rev: 6, c: sig(8, "A", "x", 0, 0) }) }), null);
+  assert.equal(verdict({ last: first(), tap: tap({ t: 1070 + SEE_MS - 1, rev: 6, c: sig(8, "A", "x", 0, 0) }), drawnAt: 1070 }), "changed");
+  assert.equal(verdict({ last: first(), tap: tap({ t: 1070 + SEE_MS, rev: 6, c: sig(8, "A", "x", 0, 0) }), drawnAt: 1070 }), null);
+});
+test("a slow page: the window starts when the new screen is drawn, not when the first tap was made", () => {
+  assert.equal(verdict({ last: first(), tap: tap({ t: 3000, hash: "#/retirement/monte-carlo" }), drawnAt: 2900 }), "new-page");
+  assert.equal(verdict({ last: first(), tap: tap({ t: 1000 + SPAN_MS + 1, hash: "#/retirement/monte-carlo" }), drawnAt: 1000 + SPAN_MS }), null, "a draw long after the last tap is not its burst");
+});
+test("a tap made while the screen was frozen (finger down before the draw finished) does nothing on the page, and lands on the top bar", () => {
+  assert.equal(verdict({ last: null, tap: tap({ t: 2000 }), drawnAt: 2900 }), "stale");
+  assert.equal(verdict({ last: first(), tap: tap({ t: 2000, x: 300, y: 100 }), drawnAt: 2900 }), "stale", "anywhere on the page, not only near the last tap");
+  assert.equal(verdict({ last: null, tap: tap({ t: 2000, inPage: false }), drawnAt: 2900 }), null);
+});
+test("same(): the same place within a few pixels, the same words; a different place is a different control", () => {
+  assert.ok(same(SAVE, sig(99, "BUTTON", "Save", 24, 603)));
+  assert.ok(!same(SAVE, sig(99, "BUTTON", "Save", 20, 650)));
+  assert.ok(!same(SAVE, sig(99, "BUTTON", "Add", 20, 600)));
+  assert.ok(!same(SAVE, null));
+});
+
+// ---- the final design's answers to its critics
+test("a tap handed over between the end of a frozen draw and the next painted frame is stale, whatever its time says (breaker S6)", () => {
+  assert.equal(verdict({ last: null, tap: tap({ t: 5000 }), drawnAt: 4000, settling: true }), "stale");
+  assert.equal(verdict({ last: null, tap: tap({ t: 5000, inPage: false }), drawnAt: 4000, settling: true }), null, "the top bar always answers");
+});
+test("a thumb that keeps tapping one spot is one gesture until it rests (person critic P3: the 4th tap of 0/400/800/1200)", () => {
+  const l = first({ t: 0, burst: 800 });
+  assert.equal(verdict({ last: l, tap: tap({ t: 1200, rev: 6, c: sig(8, "A", "Continue your plan", 20, 598, 300) }), drawnAt: 60 }), "changed");
+  assert.equal(verdict({ last: first({ t: 0 }), tap: tap({ t: 1200, rev: 6, c: sig(8, "A", "Continue your plan", 20, 598, 300) }), drawnAt: 60 }), null, "without the burst the window would have closed at 760 ms");
+  assert.equal(verdict({ last: l, tap: tap({ t: 800 + SEE_MS, rev: 6, c: sig(8, "A", "x", 0, 0) }), drawnAt: 60 }), null, "a rest of SEE_MS after the last tap ends the burst");
+});
+test("a box or a picker tapped again is never a repeat, even after the plan changed (breaker X2: State you live in)", () => {
+  const sel = sig(20, "SELECT", "select-one|||State you live in|", 20, 400, 350);
+  const l = first({ c1: sel, around: [sel], x: 100, y: 420 });
+  assert.equal(verdict({ last: l, tap: tap({ x: 100, y: 420, rev: 6, c: sel }), drawnAt: 1100 }), null);
+  assert.equal(verdict({ last: l, tap: tap({ x: 100, y: 420, rev: 6, c: { ...sel, id: 21 } }), drawnAt: 1100 }), null, "the same picker drawn again in its place");
+});
+
+// ---- the build (wave 1, seams I7 and the field signature)
+test("a box's signature carries its id and its spoken name: two unnamed pickers in one place are not 'the same control'", () => {
+  const a = fieldText({ type: "select-one", name: "", id: "cat-1", label: "Category for Rent", placeholder: "" });
+  const b = fieldText({ type: "select-one", name: "", id: "cat-2", label: "Category for Coffee", placeholder: "" });
+  assert.notEqual(a, b);
+  assert.ok(!same(sig(30, "SELECT", a, 20, 400, 350), sig(31, "SELECT", b, 20, 400, 350)), "the next row's picker that slid up is another control");
+  assert.equal(fieldText({ type: "text", name: "amount" }), "text|amount|||", "missing parts are empty, never 'undefined'");
+});
+test("the page brought something into view (planner:reveal): the window starts again from that moment, nothing is stale", () => {
+  const link = sig(8, "A", "Open my payoff plan", 20, 598, 160);
+  // the answer slid under the thumb 700 ms after the tap: a tap 300 ms later is still aimed at what was there before
+  assert.equal(verdict({ last: first(), tap: tap({ t: 2000, c: link }), movedAt: 1700 }), "changed");
+  assert.equal(verdict({ last: first(), tap: tap({ t: 2000, c: link }) }), null, "without the move the window closed at 1800 ms");
+  assert.equal(verdict({ last: null, tap: tap({ t: 1650 }), movedAt: 1700 }), null, "a move never makes a tap stale");
+  assert.equal(verdict({ last: first(), tap: tap({ t: 1700 + SEE_MS, c: link }), movedAt: 1700 }), null, "SEE_MS after the move a tap lands");
+});
diff --git a/tests/ways-back.test.mjs b/tests/ways-back.test.mjs
new file mode 100644
index 0000000..13a7cc4
--- /dev/null
+++ b/tests/ways-back.test.mjs
@@ -0,0 +1,28 @@
+// tests/ways-back.test.mjs -- wave 1 (taps): which page a page opened to fix one thing names as its way back, at the top
+// and above the one way on (modules/overview/guide/frame.js namedBack; findings j-monthly-return/MR-4, j-one-answer/A3).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { namedBack, HUBS } from "../modules/overview/guide/frame.js";
+
+test("the address says where the page was sent from (?back=<group/id>): that page, at the link's own address", () => {
+  assert.deepEqual(namedBack({ page: "balance/liabilities", query: { back: "debt/payoff" } }), { key: "debt/payoff", href: "#/debt/payoff" });
+  assert.deepEqual(namedBack({ page: "balance/net-worth", query: { back: "balance/accounts/a1" } }), { key: "balance/accounts", href: "#/balance/accounts/a1" });
+});
+test("?back=done (Get started's own), a bad value, the page itself or a page not offered: nothing", () => {
+  assert.equal(namedBack({ page: "overview/setup", query: { back: "done" } }), null);
+  assert.equal(namedBack({ page: "cashflow/income", query: { back: "<script>" } }), null);
+  assert.equal(namedBack({ page: "cashflow/income", query: { back: "javascript:alert(1)/x" } }), null);
+  assert.equal(namedBack({ page: "debt/payoff", query: { back: "debt/payoff" } }), null);
+  assert.equal(namedBack({ page: "cashflow/income", query: { back: "ai/critic" }, offered: () => false }), null);
+});
