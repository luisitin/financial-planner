diff --git a/tests/levers-saves.test.mjs b/tests/levers-saves.test.mjs
new file mode 100644
index 0000000..062a325
--- /dev/null
+++ b/tests/levers-saves.test.mjs
@@ -0,0 +1,43 @@
+// tests/levers-saves.test.mjs -- the answer after a save (levers.js answerChangeWords, spec L3) after the review of 2026-11-12:
+// Retirement settings' own save says what it did to the answer (F3); taps on Contributions are held just after one that scrolls
+// the form under the finger, so a double tap on "It matches" never lands on Cancel (B4). Invented phone-built households.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { pathToFileURL, fileURLToPath } from "node:url";
+import path from "node:path";
+import { migrate } from "../core/schema/migrate.js";
+import { compute as nbaCompute } from "../modules/overview/next-best-action/compute.js";
+import { jamie } from "../qa/fixtures/phone-households.mjs";
+
+const T = "2026-11-11";
+const ROOT = fileURLToPath(new URL("..", import.meta.url));
+const url = (p) => pathToFileURL(path.join(ROOT, p)).href;
+const cOf = { "overview/next-best-action": nbaCompute };
+
+test("F3: Retirement settings' save says what it did to the answer, and that notice stays", async () => {
+  const { renderPage } = await import("../qa/fixtures/fake-dom.mjs");
+  const VIEW = url("modules/retirement/projection/view.js");
+  const r = await renderPage(VIEW, migrate(jamie()), T, { route: { rest: [], query: {} }, computeOf: cOf });
+  const form = r.root.querySelector(".pj-settings").querySelector("form");
+  form.querySelector('[name="spendingMonthly"]').value = "2898";
+  form.dispatch("submit");
+  assert.equal(r.saved.length, 1);
+  const after = await renderPage(VIEW, r.saved[0], T, { route: { rest: [], query: {} }, computeOf: cOf });
+  assert.match(after.root.querySelector(".pj-settings").textContent, /Retirement settings saved\. Your retirement answer: now runs out at 73 \(was 70\)\./);
+});
+
+test("B4: on Contributions, just after 'It matches' scrolls the form under the finger, a second tap on the page is let go", async () => {
+  const { renderPage } = await import("../qa/fixtures/fake-dom.mjs");
+  const p = migrate(jamie()); delete p.retirement.workPlans["setup-self"].match;
+  const r = await renderPage(url("modules/retirement/contributions/view.js"), p, T, { computeOf: cOf });
+  const btn = r.root.all().find((e) => e.tagName === "BUTTON" && e.textContent === "It matches");
+  assert.ok(btn);
+  let stopped = 0;
+  const ev = { preventDefault() { stopped++; }, stopPropagation() {} };
+  r.root.dispatch("click", ev);
+  assert.equal(stopped, 0, "nothing held before");
+  btn.click();
+  r.root.dispatch("click", ev);
+  r.root.dispatch("mousedown", ev);
+  assert.equal(stopped, 2);
+});
