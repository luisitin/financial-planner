{
  "name": "financial-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Modular personal financial planning app: one HTML shell, one module per page, math in code on the PC, AI for language tasks.",
  "type": "module",
  "scripts": {
    "serve": "node server/server.mjs",
    "registry": "node tools/gen-registry.mjs",
    "test": "node tools/gen-registry.mjs && node --test \"tests/**/*.test.mjs\" \"modules/**/module.test.mjs\"",
    "build": "node tools/gen-registry.mjs && node tools/build.mjs",
    "check": "node tools/check.mjs",
    "leak-guard": "node tools/leak-guard.mjs --worktree",
    "hooks": "git config core.hooksPath .githooks",
    "prompts": "node tools/gen-prompts.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "pdfjs-dist": "^6.3.289"
  }
}
